<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Electro-Vector: Khái Niệm Điện Trường - Vật Lí 11 (Bài 17)</title>

    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>

    <!-- Xử lý an toàn ngoại lệ kết nối WebSocket -->
    <script>
        window.addEventListener('error', function(e) {
            if (e && e.message && (e.message.includes('WebSocket') || e.message.includes('SecurityError'))) {
                e.preventDefault();
                console.warn("[ElectroNet] Đã xử lý an toàn ngoại lệ kết nối.");
                return true;
            }
        });
    </script>

    <!-- Font Awesome & Google Fonts sắc nét -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Chakra+Petch:ital,wght@0,600;0,700;0,800;1,700&family=Kanit:ital,wght@0,600;0,700;0,800;0,900;1,700&family=Nunito:ital,wght@0,700;0,800;0,900;0,1000;1,800&family=Orbitron:wght@700;800;900&display=swap" rel="stylesheet">

    <!-- KaTeX hiển thị công thức Toán & Vật lí chuẩn đẹp -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css">
    <script src="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/contrib/auto-render.min.js"></script>

    <!-- Thư viện MQTT thời gian thực, SheetJS Excel, Confetti, QR Code -->
    <script src="https://cdn.jsdelivr.net/npm/mqtt@5.3.5/dist/mqtt.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>

    <style>
        html { font-size: 16px; }
        @media (min-width: 640px) { html { font-size: 17px; } }
        @media (min-width: 1024px) { html { font-size: 18px; } }
        @media (min-width: 1536px) { html { font-size: 20px; } }

        * {
            font-family: 'Nunito', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            -webkit-tap-highlight-color: transparent;
            box-sizing: border-box;
        }

        body {
            text-rendering: optimizeLegibility;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
        }

        .font-tech { font-family: 'Orbitron', 'Chakra Petch', monospace, sans-serif; }
        .font-anime-title { font-family: 'Kanit', 'Chakra Petch', 'Nunito', sans-serif; }
        .font-manga { font-family: 'Chakra Petch', 'Nunito', sans-serif; }

        .katex { font-size: 1.07em; }
        .katex .text { font-family: 'Nunito', sans-serif !important; }

        /* =========================================================================
           BẢNG MÀU LUMINOUS CRYSTAL LAB - SÁNG DỊU MẮT, TƯƠNG PHẢN CỰC CAO
           ========================================================================= */
        .electro-crystal-bg {
            background-color: #f2f7ff;
            background-image:
                radial-gradient(circle at 12% 14%, rgba(244, 63, 94, 0.12) 0%, transparent 44%),
                radial-gradient(circle at 88% 16%, rgba(14, 165, 233, 0.16) 0%, transparent 46%),
                radial-gradient(circle at 50% 90%, rgba(139, 92, 246, 0.12) 0%, transparent 48%),
                radial-gradient(rgba(14, 165, 233, 0.14) 1.25px, transparent 1.25px);
            background-size: 100% 100%, 100% 100%, 100% 100%, 28px 28px;
            color: #0f172a;
        }

        /* HIỆU ỨNG TRƯỜNG ÁNH SÁNG NỀN TRÔI CHUYỂN ĐỘNG DỊU MẮT */
        .ambient-aura {
            position: fixed;
            border-radius: 9999px;
            filter: blur(82px);
            pointer-events: none;
            z-index: 0;
            opacity: 0.48;
        }
        .aura-pos {
            width: 380px; height: 380px;
            top: -100px; left: -80px;
            background: radial-gradient(circle, rgba(251, 113, 133, 0.52), transparent 70%);
            animation: driftAuraA 13s ease-in-out infinite alternate;
        }
        .aura-field {
            width: 430px; height: 430px;
            bottom: -110px; right: -80px;
            background: radial-gradient(circle, rgba(56, 189, 248, 0.55), transparent 70%);
            animation: driftAuraB 15s ease-in-out infinite alternate;
        }
        .aura-vector {
            width: 310px; height: 310px;
            top: 48%; left: 50%;
            transform: translate(-50%, -50%);
            background: radial-gradient(circle, rgba(167, 139, 250, 0.36), transparent 70%);
            animation: driftAuraC 11s ease-in-out infinite alternate;
        }

        @keyframes driftAuraA {
            0% { transform: translate(0, 0) scale(1); }
            100% { transform: translate(75px, 50px) scale(1.16); }
        }
        @keyframes driftAuraB {
            0% { transform: translate(0, 0) scale(1); }
            100% { transform: translate(-70px, -45px) scale(1.14); }
        }
        @keyframes driftAuraC {
            0% { transform: translate(-50%, -50%) scale(0.92); }
            100% { transform: translate(-45%, -55%) scale(1.18); }
        }

        /* =========================================================================
           THẺ KÍNH MỜ CAO CẤP (FROSTED CRYSTAL GLASS) & VIỀN DẢI MÀU ĐỘNG
           ========================================================================= */
        .field-card-prism {
            background: rgba(255, 255, 255, 0.94);
            backdrop-filter: blur(22px);
            border: 2px solid transparent;
            background-clip: padding-box;
            box-shadow: 0 18px 42px -12px rgba(15, 23, 42, 0.12), 0 5px 0 rgba(203, 213, 225, 0.85);
            border-radius: 1.5rem;
            position: relative;
        }
        .field-card-prism::before {
            content: '';
            position: absolute;
            inset: -2px;
            border-radius: 1.62rem;
            background: linear-gradient(120deg, #f43f5e, #0ea5e9, #8b5cf6, #f59e0b, #f43f5e);
            background-size: 280% 280%;
            animation: electricBorderFlow 6s linear infinite;
            z-index: -1;
        }

        .field-card-cyan {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(18px);
            border: 2px solid #7dd3fc;
            box-shadow: 0 14px 32px -10px rgba(14, 165, 233, 0.16), 0 4px 0 #bae6fd;
            border-radius: 1.5rem;
            transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.25s ease;
        }

        .field-card-coral {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(18px);
            border: 2px solid #fda4af;
            box-shadow: 0 14px 32px -10px rgba(244, 63, 94, 0.15), 0 4px 0 #fecdd3;
            border-radius: 1.5rem;
            transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.25s ease;
        }

        .field-card-gold {
            background: linear-gradient(180deg, #fffdf4 0%, #ffffff 100%);
            backdrop-filter: blur(18px);
            border: 2.5px solid #f59e0b;
            box-shadow: 0 18px 40px -10px rgba(245, 158, 11, 0.24), 0 5px 0 #fde68a;
            border-radius: 1.5rem;
        }

        @keyframes electricBorderFlow {
            0% { background-position: 0% 50%; }
            100% { background-position: 200% 50%; }
        }

        /* =========================================================================
           HOẠT ẢNH CHUYỂN CẢNH, ĐÁP ÁN BẬT NẢY, VỆT SÁNG QUÉT & ĐỒNG HỒ GẤP GÁP
           ========================================================================= */
        main > section:not(.hidden) {
            animation: screenReveal 0.45s cubic-bezier(0.22, 1, 0.36, 1) both;
        }
        @keyframes screenReveal {
            0% { opacity: 0; transform: translateY(20px) scale(0.985); }
            100% { opacity: 1; transform: translateY(0) scale(1); }
        }

        @keyframes optPopIn {
            0% { opacity: 0; transform: translateY(14px) scale(0.95); }
            100% { opacity: 1; transform: translateY(0) scale(1); }
        }
        .opt-stagger-0 { animation: optPopIn 0.36s cubic-bezier(0.34, 1.56, 0.64, 1) 0.04s both; }
        .opt-stagger-1 { animation: optPopIn 0.36s cubic-bezier(0.34, 1.56, 0.64, 1) 0.11s both; }
        .opt-stagger-2 { animation: optPopIn 0.36s cubic-bezier(0.34, 1.56, 0.64, 1) 0.18s both; }
        .opt-stagger-3 { animation: optPopIn 0.36s cubic-bezier(0.34, 1.56, 0.64, 1) 0.25s both; }

        @keyframes vectorPulse {
            0%, 100% { transform: rotate(-4deg) scale(1); }
            50% { transform: rotate(4deg) scale(1.06); }
        }
        .vector-pulse { animation: vectorPulse 3.2s ease-in-out infinite; }

        @keyframes gentleFloat {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-6px); }
        }
        .gentle-float { animation: gentleFloat 2.6s ease-in-out infinite; }

        @keyframes correctPop {
            0% { transform: scale(1); }
            45% { transform: scale(1.035); }
            100% { transform: scale(1); }
        }
        .correct-pop { animation: correctPop 0.45s cubic-bezier(0.34, 1.56, 0.64, 1); }

        @keyframes timerUrgent {
            0%, 100% { transform: scale(1); border-color: #ef4444; box-shadow: 0 0 0 0 rgba(239, 68, 68, 0.48); }
            50% { transform: scale(1.08); border-color: #dc2626; box-shadow: 0 0 0 9px rgba(239, 68, 68, 0); }
        }
        .timer-urgent { animation: timerUrgent 0.62s ease-in-out infinite; }

        @keyframes podiumRise {
            0% { transform: scaleY(0.18); opacity: 0; transform-origin: bottom; }
            100% { transform: scaleY(1); opacity: 1; transform-origin: bottom; }
        }
        .podium-rise { animation: podiumRise 0.58s cubic-bezier(0.34, 1.56, 0.64, 1) both; }

        @keyframes pulseBanner {
            0%, 100% { opacity: 0.86; transform: scale(1); }
            50% { opacity: 1; transform: scale(1.015); }
        }
        .pulse-banner { animation: pulseBanner 1.15s ease-in-out infinite; }

        /* Phím chọn 2x2 Sáng Đẹp + Vệt Sáng Quét Glossy khi Hover */
        .btn-opt-tile {
            transition: all 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
            position: relative;
            overflow: hidden;
            box-shadow: 0 5px 0 rgba(15, 23, 42, 0.08), 0 10px 20px -8px rgba(15, 23, 42, 0.09);
        }
        .btn-opt-tile::after {
            content: '';
            position: absolute;
            top: 0; left: -120%;
            width: 68%; height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.72), transparent);
            transform: skewX(-22deg);
            transition: left 0.55s ease;
            pointer-events: none;
        }
        .btn-opt-tile:hover:not(:disabled)::after { left: 145%; }
        .btn-opt-tile:hover:not(:disabled) {
            transform: translateY(-3px) scale(1.012);
            box-shadow: 0 8px 0 rgba(15, 23, 42, 0.12), 0 14px 26px -8px rgba(15, 23, 42, 0.14);
        }
        .btn-opt-tile:active:not(:disabled) {
            transform: translateY(2px) scale(0.99);
            box-shadow: 0 2px 0 rgba(15, 23, 42, 0.12);
        }

        /* 4 Tông Màu Pastel Tương Phản Cao (Đọc cực rõ từ cuối lớp) */
        .opt-style-a {
            background: linear-gradient(135deg, #fff1f2 0%, #ffe4e6 100%);
            border: 2px solid #fb7185;
            color: #881337;
        }
        .opt-style-b {
            background: linear-gradient(135deg, #f0f9ff 0%, #e0f2fe 100%);
            border: 2px solid #38bdf8;
            color: #0c4a6e;
        }
        .opt-style-c {
            background: linear-gradient(135deg, #fffbeb 0%, #fef3c7 100%);
            border: 2px solid #f59e0b;
            color: #78350f;
        }
        .opt-style-d {
            background: linear-gradient(135deg, #f5f3ff 0%, #ede9fe 100%);
            border: 2px solid #8b5cf6;
            color: #4c1d95;
        }

        /* Nút CTA có hiệu ứng ánh sáng lướt qua */
        .btn-cta-shine {
            position: relative;
            overflow: hidden;
            transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.2s ease;
        }
        .btn-cta-shine::after {
            content: '';
            position: absolute;
            top: 0; left: -110%;
            width: 60%; height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.38), transparent);
            transform: skewX(-20deg);
            transition: left 0.6s ease;
            pointer-events: none;
        }
        .btn-cta-shine:hover:not(:disabled)::after { left: 140%; }
        .btn-cta-shine:hover:not(:disabled) {
            transform: translateY(-2.5px);
            box-shadow: 0 14px 26px -6px rgba(14, 165, 233, 0.35);
        }
        .btn-cta-shine:active:not(:disabled) {
            transform: translateY(1px);
        }

        ::-webkit-scrollbar { width: 8px; height: 8px; }
        ::-webkit-scrollbar-track { background: #e2e8f0; border-radius: 99px; }
        ::-webkit-scrollbar-thumb { background: #38bdf8; border: 2px solid #e2e8f0; border-radius: 99px; }
        ::-webkit-scrollbar-thumb:hover { background: #0284c7; }
    </style>
</head>
<body class="electro-crystal-bg min-h-screen flex flex-col relative overflow-x-hidden selection:bg-sky-200 selection:text-sky-950">

    <!-- HIỆU ỨNG TRƯỜNG ÁNH SÁNG NỀN CHUYỂN ĐỘNG -->
    <div class="ambient-aura aura-pos"></div>
    <div class="ambient-aura aura-field"></div>
    <div class="ambient-aura aura-vector"></div>

    <!-- THANH ĐIỀU KHIỂN NỔI SÁNG ĐẸP (FLOATING CRYSTAL HEADER) -->
    <header class="w-full px-3 sm:px-6 pt-3 z-40 sticky top-0">
        <div class="max-w-6xl mx-auto bg-white/92 backdrop-blur-xl border-2 border-slate-200/90 rounded-2xl px-4 py-2.5 flex flex-wrap justify-between items-center gap-2 shadow-[0_10px_30px_-10px_rgba(15,23,42,0.12)]">
            <div class="flex items-center gap-3">
                <!-- Biểu tượng Vectơ Cường Độ Điện Trường E chuyển động -->
                <div class="w-11 h-11 sm:w-12 sm:h-12 rounded-xl bg-gradient-to-tr from-rose-500 via-sky-500 to-violet-600 text-white flex items-center justify-center shadow-md border-2 border-white flex-shrink-0 font-tech font-black text-xl sm:text-2xl vector-pulse">
                    E⃗
                </div>
                <div>
                    <div class="flex items-center gap-2">
                        <span class="px-2.5 py-0.5 rounded-md bg-rose-100 text-rose-700 font-manga text-[10px] sm:text-xs font-black uppercase tracking-wider border border-rose-200">
                            ⚡ VẬT LÍ 11 • BÀI 17: KHÁI NIỆM ĐIỆN TRƯỜNG
                        </span>
                        <span id="headerPinBadge" class="hidden px-2.5 py-0.5 rounded-md bg-sky-100 text-sky-800 font-tech text-xs font-black border border-sky-300">
                            PIN: <strong id="headerLivePin" class="text-rose-600">----</strong>
                        </span>
                    </div>
                    <h1 class="font-anime-title text-sm sm:text-lg md:text-xl text-slate-900 tracking-wide leading-tight uppercase font-black">
                        ELECTRO-VECTOR: ĐIỆN TRƯỜNG & ĐƯỜNG SỨC ĐIỆN
                    </h1>
                </div>
            </div>

            <!-- Thanh Tiến Độ 10 Câu Hỏi (Hiện khi thi đấu) -->
            <div id="headerProgressStrip" class="hidden lg:flex items-center gap-1 bg-slate-100 px-3 py-1.5 rounded-xl border border-slate-200">
                <span class="text-[10px] font-manga font-black text-slate-500 uppercase mr-1">TIẾN ĐỘ:</span>
                <div id="headerStepDots" class="flex items-center gap-1"></div>
            </div>

            <div class="flex items-center gap-2">
                <button id="sfxToggleBtn" onclick="toggleAudio()" class="p-2 w-10 h-10 rounded-xl bg-slate-100 hover:bg-sky-50 text-sky-600 border border-slate-200 text-sm font-bold flex items-center justify-center transition" title="Bật/Tắt âm thanh">
                    <i class="fa-solid fa-volume-high text-sky-600 text-base" id="sfxIcon"></i>
                </button>
                <button onclick="window.location.reload()" class="btn-cta-shine px-3.5 py-2 rounded-xl bg-gradient-to-r from-rose-500 via-sky-500 to-violet-600 text-xs font-black flex items-center gap-1.5 transition text-white shadow-md">
                    <i class="fa-solid fa-rotate"></i>
                    <span class="hidden sm:inline font-manga">TRANG CHỦ</span>
                </button>
            </div>
        </div>
    </header>

    <div id="toastBox" class="fixed top-20 left-1/2 -translate-x-1/2 z-50 px-6 py-2.5 rounded-xl text-xs sm:text-sm font-black shadow-xl transition-all duration-300 opacity-0 pointer-events-none border-2"></div>

    <main class="flex-1 flex flex-col p-3 sm:p-5 max-w-6xl w-full mx-auto justify-center z-10 relative">

        <!-- 0. MÀN HÌNH CHỌN VAI TRÒ -->
        <section id="roleSelectScreen" class="w-full max-w-5xl mx-auto my-auto flex flex-col gap-5">
            <div class="field-card-prism p-6 sm:p-8 text-center">
                <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-sky-50 border border-sky-200 text-sky-800 text-xs font-black mb-3 shadow-sm">
                    <span>⚡ VẬT LÍ 11 – KẾT NỐI TRI THỨC • BÀI 17: $\vec{E} = \frac{\vec{F}}{q} \cdot E = k\frac{|Q|}{r^2} \cdot \vec{E} = \vec{E}_1 + \vec{E}_2$</span>
                </div>
                <h2 class="text-2xl sm:text-4xl md:text-5xl font-anime-title font-black text-transparent bg-clip-text bg-gradient-to-r from-rose-600 via-sky-600 to-violet-600 tracking-wide uppercase">
                    PHÒNG THÍ NGHIỆM ĐIỆN TRƯỜNG & ĐƯỜNG SỨC ĐIỆN
                </h2>
                <p class="text-xs sm:text-base text-slate-600 max-w-3xl mx-auto mt-3 font-bold leading-relaxed">
                    Khám phá điện trường của điện tích điểm ($Q > 0$ hướng ra xa, $Q < 0$ hướng vào trong), công thức $E = \frac{F}{q} = k\frac{|Q|}{r^2}$, tổng hợp vectơ cường độ điện trường và tính chất đường sức điện.<br>
                    • Giải đúng: Khuếch đại điện trường chuẩn <span class="text-emerald-600 font-black">+100 V/m (+100 Điểm)</span> • Sai lần 1: <span class="text-amber-600 font-black">Nhiễu loạn điện trường (-25 V/m)</span> • Sai lần 2 liên tiếp: <span class="text-rose-600 font-black">Đánh thủng điện môi (-75 V/m)</span>!
                </p>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                <!-- Cột Máy Chiếu (Host) -->
                <button onclick="initHostMode()" class="field-card-coral p-6 sm:p-8 text-left hover:-translate-y-1.5 transition group flex flex-col justify-between">
                    <div>
                        <div class="flex items-center justify-between mb-4">
                            <span class="px-3 py-1 rounded-lg bg-rose-100 text-rose-700 font-tech text-xs font-black border border-rose-200">FIELD CONSOLE • HOST</span>
                            <div class="w-14 h-14 rounded-2xl bg-rose-50 border-2 border-rose-300 flex items-center justify-center text-3xl group-hover:scale-110 transition gentle-float">
                                🖥️
                            </div>
                        </div>
                        <h3 class="text-xl sm:text-2xl font-anime-title font-black text-slate-900 uppercase">TRẠM ĐO ĐIỆN TRƯỜNG (MÁY CHIẾU)</h3>
                        <p class="text-xs sm:text-sm text-slate-600 mt-2 font-semibold leading-relaxed">
                            Trình chiếu Mã PIN & QR, mô phỏng trực quan 4 thí nghiệm SGK (Điện tích điểm $Q$, Quy luật $1/r^2$, Tổng hợp $\vec{E}_1 + \vec{E}_2$, Mật độ đường sức điện) và xuất Excel.
                        </p>
                    </div>
                    <div class="btn-cta-shine mt-6 w-full py-3.5 rounded-xl bg-gradient-to-r from-rose-500 to-pink-600 text-white font-anime-title text-center text-sm font-black uppercase tracking-wider shadow-lg">
                        MỞ PHÒNG MÁY CHIẾU ⚡
                    </div>
                </button>

                <!-- Cột Điện Thoại (Player) -->
                <button onclick="initPlayerMode()" class="field-card-cyan p-6 sm:p-8 text-left hover:-translate-y-1.5 transition group flex flex-col justify-between">
                    <div>
                        <div class="flex items-center justify-between mb-4">
                            <span class="px-3 py-1 rounded-lg bg-sky-100 text-sky-700 font-tech text-xs font-black border border-sky-200">PROBE PAD • PLAYER</span>
                            <div class="w-14 h-14 rounded-2xl bg-sky-50 border-2 border-sky-300 flex items-center justify-center text-3xl group-hover:scale-110 transition gentle-float">
                                📱
                            </div>
                        </div>
                        <h3 class="text-xl sm:text-2xl font-anime-title font-black text-slate-900 uppercase">ĐẦU DÒ ĐIỆN TÍCH THỬ (ĐIỆN THOẠI)</h3>
                        <p class="text-xs sm:text-sm text-slate-600 mt-2 font-semibold leading-relaxed">
                            Quét mã QR hoặc nhập mã PIN để đồng bộ điện tích thử $q$, giải nhanh 10 câu trắc nghiệm Bài 17 trên lưới 4 phím bấm sáng rõ, siêu nhạy.
                        </p>
                    </div>
                    <div class="btn-cta-shine mt-6 w-full py-3.5 rounded-xl bg-gradient-to-r from-sky-500 to-indigo-600 text-white font-anime-title text-center text-sm font-black uppercase tracking-wider shadow-lg">
                        KẾT NỐI TAY CẦM HỌC SINH 🚀
                    </div>
                </button>
            </div>
        </section>

        <!-- 1. MÀN HÌNH SẢNH CHỜ MÁY CHIẾU (HOST LOBBY) -->
        <section id="hostLobbyScreen" class="w-full max-w-5xl mx-auto field-card-prism p-6 sm:p-8 my-auto hidden flex flex-col gap-5">
            <div class="flex flex-wrap items-center justify-between border-b border-slate-200 pb-3.5 gap-2">
                <div class="flex items-center gap-2.5">
                    <span class="w-3.5 h-3.5 rounded-full bg-emerald-500 animate-ping"></span>
                    <span class="font-anime-title text-base sm:text-xl text-slate-900 uppercase font-black">
                        SẢNH CHỜ THÍ NGHIỆM: BÀI 17 – KHÁI NIỆM ĐIỆN TRƯỜNG (VẬT LÍ 11)
                    </span>
                </div>
                <div class="px-4 py-1.5 rounded-xl bg-sky-50 border border-sky-200 text-xs sm:text-sm font-black text-slate-700">
                    Đội tham gia: <span class="text-sky-600 font-tech text-xl" id="hostPlayerCountNum">0</span> đội
                </div>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-12 gap-5 items-stretch">
                <div class="lg:col-span-5 p-5 rounded-2xl bg-slate-50 border border-slate-200 flex flex-col items-center justify-between text-center gap-3">
                    <div>
                        <span class="text-xs font-black text-rose-600 uppercase tracking-widest block font-manga">MÃ PHÒNG ĐIỆN TRƯỜNG (PIN)</span>
                        <div class="flex items-center justify-center gap-2.5 mt-2">
                            <span id="hostPinDisplay" class="text-4xl sm:text-6xl font-tech font-black text-sky-700 px-6 py-2 rounded-2xl bg-white border-2 border-sky-400 tracking-widest shadow-sm">
                                ----
                            </span>
                            <button onclick="copyJoinLink()" class="p-3.5 rounded-2xl bg-white hover:bg-sky-50 text-sky-600 border border-slate-200 text-base font-bold transition shadow-sm" title="Sao chép link">
                                <i class="fa-solid fa-copy"></i>
                            </button>
                        </div>
                    </div>

                    <div class="flex flex-col items-center bg-white p-3.5 rounded-2xl shadow-md border-4 border-rose-400">
                        <div onclick="openQrModal()" class="cursor-pointer hover:opacity-90 transition">
                            <div id="hostQrCodeBox" class="w-[136px] h-[136px] flex items-center justify-center overflow-hidden"></div>
                        </div>
                        <button onclick="openQrModal()" class="text-xs font-black text-slate-700 mt-2 flex items-center gap-1.5 hover:text-rose-600 font-manga">
                            <i class="fa-solid fa-expand"></i> Phóng To Mã QR
                        </button>
                    </div>
                    <p class="text-xs text-slate-500 font-bold">Học sinh quét QR hoặc mở Tab mới nhập mã PIN để đồng bộ đầu dò điện trường.</p>
                </div>

                <div class="lg:col-span-7 flex flex-col justify-between gap-4">
                    <div class="p-5 rounded-2xl bg-slate-50 border border-slate-200 flex-1 flex flex-col">
                        <div class="flex justify-between items-center border-b border-slate-200 pb-2.5 mb-3">
                            <span class="text-xs sm:text-sm font-black text-slate-800 uppercase font-anime-title">Các đội kỹ sư đã sẵn sàng</span>
                            <span class="text-xs font-manga font-black text-violet-600">MỤC TIÊU: 1000 V/m ĐIỆN TRƯỜNG</span>
                        </div>
                        <div class="flex-1 min-h-[180px] max-h-[240px] overflow-y-auto p-2 flex flex-col justify-center">
                            <p class="text-sm text-slate-400 italic text-center font-bold" id="emptyPlayerMsg">Đang chờ tín hiệu từ điện thoại học sinh...</p>
                            <div class="flex flex-wrap gap-2 items-center justify-center" id="hostPlayerListContainer"></div>
                        </div>
                    </div>

                    <div class="flex flex-col sm:flex-row items-center justify-between gap-3">
                        <div class="flex gap-2 w-full sm:w-auto">
                            <button onclick="addDemoBots(4)" type="button" class="px-4 py-3 rounded-xl bg-sky-50 hover:bg-sky-100 text-sky-700 text-xs sm:text-sm font-black border border-sky-300 transition flex items-center gap-2 flex-1 sm:flex-none justify-center font-manga">
                                <i class="fa-solid fa-robot"></i> +4 Đội Bot Mẫu
                            </button>
                            <button onclick="clearDemoBots()" type="button" class="px-3.5 py-3 rounded-xl bg-slate-100 hover:bg-rose-50 hover:text-rose-600 text-slate-500 text-xs sm:text-sm font-black border border-slate-200 transition" title="Xóa danh sách">
                                <i class="fa-solid fa-trash-can"></i>
                            </button>
                        </div>

                        <button onclick="hostStartGame()" id="hostStartBtn" class="btn-cta-shine w-full sm:w-auto px-8 py-3.5 rounded-xl bg-gradient-to-r from-rose-500 via-sky-500 to-violet-600 text-white font-anime-title text-sm sm:text-base uppercase tracking-wider transition shadow-lg disabled:opacity-40 disabled:pointer-events-none flex items-center justify-center gap-2 font-black" disabled>
                            <span>KHỞI ĐỘNG ĐIỆN TRƯỜNG</span>
                            <i class="fa-solid fa-bolt text-xs"></i>
                        </button>
                    </div>
                </div>
            </div>
        </section>

        <!-- 2. MÀN HÌNH THI ĐẤU MÁY CHIẾU (TRÁI: MÔ PHỎNG 5 CỘT • PHẢI: CÂU HỎI & LƯỚI 2x2 7 CỘT) -->
        <section id="hostQuestionScreen" class="w-full max-w-6xl mx-auto flex flex-col gap-3.5 hidden">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-4 items-stretch">

                <!-- CỘT TRÁI (5 CỘT): PHÒNG THÍ NGHIỆM ĐIỆN TRƯỜNG & VECTƠ E -->
                <div class="lg:col-span-5 field-card-cyan p-4 flex flex-col justify-between gap-3">
                    <div class="flex items-center justify-between border-b border-slate-200 pb-2">
                        <span id="simHeaderTitle" class="text-xs font-anime-title uppercase text-sky-700 font-black flex items-center gap-1.5">
                            <i class="fa-solid fa-atom text-rose-500"></i> THÍ NGHIỆM ĐIỆN TRƯỜNG
                        </span>
                        <span id="simLiveFormulaTag" class="font-tech text-[10px] text-violet-800 bg-violet-100 px-2 py-0.5 rounded border border-violet-300 font-bold">
                            E = k·|Q| / r²
                        </span>
                    </div>

                    <!-- Khung Canvas Mô Phỏng Trực Quan Sáng Rõ & Động -->
                    <div class="w-full h-64 sm:h-72 relative bg-slate-50 rounded-2xl border-2 border-sky-200 overflow-hidden shadow-inner">
                        <canvas id="electroSimCanvas" class="w-full h-full block"></canvas>

                        <!-- Cảnh báo 1: Nhiễu loạn điện trường -->
                        <div id="simWarningAlert" class="absolute inset-0 bg-amber-50/94 backdrop-blur-sm flex flex-col items-center justify-center text-center p-4 hidden z-20 pulse-banner border-2 border-amber-400">
                            <span class="text-4xl">⚠️⚡</span>
                            <h3 class="font-anime-title font-black text-amber-700 text-lg uppercase mt-1">NHIỄU LOẠN ĐIỆN TRƯỜNG!</h3>
                            <p class="text-xs text-amber-900 font-bold mt-1">Có đội xác định nhầm chiều vectơ $\vec{E}$ hoặc sai tỉ lệ khoảng cách $r^2$!</p>
                        </div>

                        <!-- Cảnh báo 2: Đánh thủng điện môi -->
                        <div id="simPopAlert" class="absolute inset-0 bg-rose-50/95 backdrop-blur-sm flex flex-col items-center justify-center text-center p-4 hidden z-20 border-2 border-rose-400">
                            <span class="text-5xl animate-bounce">💥</span>
                            <h3 class="font-anime-title font-black text-rose-600 text-xl uppercase mt-1">ĐÁNH THỦNG ĐIỆN MÔI!</h3>
                            <p class="text-xs text-rose-900 font-bold mt-1">Sai số liên tiếp gây phóng điện hồ quang quá tải trong buồng đo!</p>
                        </div>

                        <!-- Cảnh báo 3: Triệt tiêu điện trường -->
                        <div id="simSpikeAlert" class="absolute inset-0 bg-sky-50/95 backdrop-blur-sm flex flex-col items-center justify-center text-center p-4 hidden z-20 border-2 border-sky-400">
                            <span class="text-5xl animate-bounce">⚡⚠️</span>
                            <h3 class="font-anime-title font-black text-sky-700 text-xl uppercase mt-1">MẤT TÍN HIỆU ĐẦU DÒ!</h3>
                            <p class="text-xs text-sky-900 font-bold mt-1">Đầu dò điện tích thử bị lệch khỏi đường sức điện!</p>
                        </div>

                        <!-- Thông báo 4: Đo cường độ điện trường hoàn hảo -->
                        <div id="simSuccessAlert" class="absolute inset-0 bg-emerald-50/93 backdrop-blur-sm flex flex-col items-center justify-center text-center p-4 hidden z-20 border-2 border-emerald-400">
                            <span class="text-4xl animate-bounce">⚡✨</span>
                            <h3 class="font-anime-title font-black text-emerald-700 text-xl uppercase mt-1">ĐO VECTƠ $\vec{E}$ CHUẨN XÁC!</h3>
                            <p class="text-xs text-emerald-900 font-bold mt-1">Chiều đường sức và cường độ điện trường tổng hợp chính xác tuyệt đối!</p>
                        </div>
                    </div>

                    <!-- 3 Ô Chỉ Số Trực Tiếp -->
                    <div class="grid grid-cols-3 gap-2 text-center">
                        <div class="p-2 rounded-xl bg-rose-50/80 border border-rose-200">
                            <span class="text-[9px] text-rose-700 font-manga block uppercase font-black">MÔ HÌNH</span>
                            <span id="hostSimModeText" class="font-manga font-black text-slate-900 text-[11px] truncate block">ĐIỆN TÍCH ĐIỂM</span>
                        </div>
                        <div class="p-2 rounded-xl bg-violet-50/80 border border-violet-200">
                            <span class="text-[9px] text-violet-700 font-manga block uppercase font-black">CƯỜNG ĐỘ TB</span>
                            <span id="hostAvgAltText" class="font-tech font-black text-violet-700 text-xs sm:text-sm">0 V/m</span>
                        </div>
                        <div class="p-2 rounded-xl bg-sky-50/80 border border-sky-200">
                            <span class="text-[9px] text-sky-700 font-manga block uppercase font-black">ĐÃ NỘP BÀI</span>
                            <span class="font-tech font-black text-sky-700 text-xs sm:text-sm"><span id="hostAnsweredCount">0</span>/<span id="hostTotalPlayersCount">0</span></span>
                        </div>
                    </div>

                    <!-- Trạng thái trực tiếp các đội -->
                    <div class="bg-slate-50 rounded-xl p-2.5 border border-slate-200">
                        <div class="flex justify-between items-center text-[10px] font-manga text-slate-500 mb-1.5 font-black">
                            <span>TRẠNG THÁI CÁC ĐỘI</span>
                            <span class="text-sky-600 flex items-center gap-1"><span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-ping"></span> LIVE</span>
                        </div>
                        <div id="hostLiveSquadGrid" class="grid grid-cols-2 gap-1.5 max-h-[95px] overflow-y-auto pr-1"></div>
                    </div>
                </div>

                <!-- CỘT PHẢI (7 CỘT): CÂU HỎI, THANH ĐẾM NGƯỢC & LƯỚI ĐÁP ÁN 2x2 -->
                <div class="lg:col-span-7 flex flex-col gap-3.5">
                    <div class="field-card-coral p-5 sm:p-6 flex-1 flex flex-col justify-between gap-4">
                        <div>
                            <!-- Header Câu hỏi + Đồng hồ -->
                            <div class="flex items-center justify-between gap-2 mb-2.5">
                                <div class="flex items-center gap-2">
                                    <span id="hostQCounterBadge" class="px-3 py-1 rounded-lg text-xs font-tech font-black bg-rose-500 text-white shadow-sm">
                                        CÂU 1 / 10
                                    </span>
                                    <span id="hostQCategory" class="text-xs sm:text-sm font-black text-slate-600 font-anime-title">
                                        Câu 1. Nguồn gốc tạo ra điện trường
                                    </span>
                                </div>
                                <div id="hostTimerWrap" class="flex items-center gap-1.5 px-3.5 py-1 rounded-xl bg-amber-50 border-2 border-amber-400 transition">
                                    <i class="fa-solid fa-stopwatch text-amber-600"></i>
                                    <span id="hostTimerText" class="font-tech font-black text-xl sm:text-2xl text-slate-900">30</span>
                                    <span class="text-[10px] font-tech text-amber-700 font-bold">s</span>
                                </div>
                            </div>

                            <!-- Thanh tiến độ thời gian mượt mà -->
                            <div class="w-full h-2.5 bg-slate-100 rounded-full overflow-hidden mb-3.5 border border-slate-200">
                                <div id="hostTimerBar" class="h-full bg-gradient-to-r from-rose-500 via-sky-500 to-violet-500 transition-all duration-1000 rounded-full" style="width: 100%"></div>
                            </div>

                            <!-- Nội dung câu hỏi -->
                            <h2 id="hostQuestionTitle" class="text-lg sm:text-xl md:text-2xl font-black text-slate-900 leading-relaxed font-anime-title">
                                Đang tải câu hỏi...
                            </h2>
                        </div>

                        <!-- Lưới 2x2 cho 4 phương án A, B, C, D -->
                        <div id="hostMcqGrid" class="grid grid-cols-1 md:grid-cols-2 gap-3">
                            <!-- A -->
                            <div id="hostOptCard0" class="p-4 rounded-2xl opt-style-a flex flex-col justify-between gap-2 btn-opt-tile">
                                <div class="flex items-center justify-between gap-2.5">
                                    <div class="flex items-center gap-3 flex-1">
                                        <span class="w-9 h-9 rounded-xl bg-rose-500 text-white flex items-center justify-center font-tech text-base font-black flex-shrink-0 shadow-sm">A</span>
                                        <span id="hostOptText0" class="text-sm sm:text-base font-black break-words flex-1">Phương án A</span>
                                    </div>
                                    <span id="hostOptBadge0" class="hidden px-2.5 py-1 rounded-lg bg-emerald-500 text-white font-anime-title text-xs font-black whitespace-nowrap shadow">✓ ĐÚNG</span>
                                </div>
                                <div id="hostOptStatWrap0" class="hidden w-full bg-white/80 rounded-full h-2 overflow-hidden border border-rose-200">
                                    <div id="hostOptBar0" class="bg-rose-500 h-full transition-all duration-700" style="width: 0%"></div>
                                </div>
                            </div>

                            <!-- B -->
                            <div id="hostOptCard1" class="p-4 rounded-2xl opt-style-b flex flex-col justify-between gap-2 btn-opt-tile">
                                <div class="flex items-center justify-between gap-2.5">
                                    <div class="flex items-center gap-3 flex-1">
                                        <span class="w-9 h-9 rounded-xl bg-sky-600 text-white flex items-center justify-center font-tech text-base font-black flex-shrink-0 shadow-sm">B</span>
                                        <span id="hostOptText1" class="text-sm sm:text-base font-black break-words flex-1">Phương án B</span>
                                    </div>
                                    <span id="hostOptBadge1" class="hidden px-2.5 py-1 rounded-lg bg-emerald-500 text-white font-anime-title text-xs font-black whitespace-nowrap shadow">✓ ĐÚNG</span>
                                </div>
                                <div id="hostOptStatWrap1" class="hidden w-full bg-white/80 rounded-full h-2 overflow-hidden border border-sky-200">
                                    <div id="hostOptBar1" class="bg-sky-600 h-full transition-all duration-700" style="width: 0%"></div>
                                </div>
                            </div>

                            <!-- C -->
                            <div id="hostOptCard2" class="p-4 rounded-2xl opt-style-c flex flex-col justify-between gap-2 btn-opt-tile">
                                <div class="flex items-center justify-between gap-2.5">
                                    <div class="flex items-center gap-3 flex-1">
                                        <span class="w-9 h-9 rounded-xl bg-amber-500 text-white flex items-center justify-center font-tech text-base font-black flex-shrink-0 shadow-sm">C</span>
                                        <span id="hostOptText2" class="text-sm sm:text-base font-black break-words flex-1">Phương án C</span>
                                    </div>
                                    <span id="hostOptBadge2" class="hidden px-2.5 py-1 rounded-lg bg-emerald-500 text-white font-anime-title text-xs font-black whitespace-nowrap shadow">✓ ĐÚNG</span>
                                </div>
                                <div id="hostOptStatWrap2" class="hidden w-full bg-white/80 rounded-full h-2 overflow-hidden border border-amber-200">
                                    <div id="hostOptBar2" class="bg-amber-500 h-full transition-all duration-700" style="width: 0%"></div>
                                </div>
                            </div>

                            <!-- D -->
                            <div id="hostOptCard3" class="p-4 rounded-2xl opt-style-d flex flex-col justify-between gap-2 btn-opt-tile">
                                <div class="flex items-center justify-between gap-2.5">
                                    <div class="flex items-center gap-3 flex-1">
                                        <span class="w-9 h-9 rounded-xl bg-violet-600 text-white flex items-center justify-center font-tech text-base font-black flex-shrink-0 shadow-sm">D</span>
                                        <span id="hostOptText3" class="text-sm sm:text-base font-black break-words flex-1">Phương án D</span>
                                    </div>
                                    <span id="hostOptBadge3" class="hidden px-2.5 py-1 rounded-lg bg-emerald-500 text-white font-anime-title text-xs font-black whitespace-nowrap shadow">✓ ĐÚNG</span>
                                </div>
                                <div id="hostOptStatWrap3" class="hidden w-full bg-white/80 rounded-full h-2 overflow-hidden border border-violet-200">
                                    <div id="hostOptBar3" class="bg-violet-600 h-full transition-all duration-700" style="width: 0%"></div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Khung Giải Thích Vật Lí & Nút Bảng Xếp Hạng -->
                    <div id="hostExplanationArea" class="field-card-prism p-4 sm:p-5 flex flex-col gap-3 hidden">
                        <div class="flex flex-col sm:flex-row items-center justify-between gap-2 border-b border-slate-200 pb-2">
                            <span class="text-xs font-manga font-black uppercase text-sky-700 flex items-center gap-1.5">
                                <i class="fa-solid fa-lightbulb text-amber-500"></i> PHÂN TÍCH VẬT LÍ: BÀI 17 – KHÁI NIỆM ĐIỆN TRƯỜNG
                            </span>
                            <button onclick="hostShowLeaderboardScreen()" class="btn-cta-shine px-6 py-2.5 rounded-xl bg-gradient-to-r from-rose-500 via-sky-500 to-violet-600 text-white font-anime-title text-xs sm:text-sm uppercase tracking-wider transition shadow-md font-black flex items-center gap-2">
                                <span>BẢNG XẾP HẠNG CƯỜNG ĐỘ E</span>
                                <i class="fa-solid fa-trophy text-amber-200"></i>
                            </button>
                        </div>
                        <div id="hostExplanationText" class="text-xs sm:text-sm md:text-base text-slate-800 bg-slate-50 border border-slate-200 p-3.5 rounded-xl font-bold leading-relaxed"></div>
                    </div>
                </div>
            </div>
        </section>

        <!-- 3. MÀN HÌNH BẢNG XẾP HẠNG VÒNG (HOST LEADERBOARD) -->
        <section id="hostLeaderboardScreen" class="w-full max-w-5xl mx-auto field-card-gold p-6 sm:p-8 my-auto hidden flex flex-col gap-5">
            <div class="flex flex-col sm:flex-row items-center justify-between border-b border-amber-200 pb-3.5 gap-3">
                <div class="flex items-center gap-3">
                    <div class="w-12 h-12 rounded-xl bg-amber-100 text-amber-600 border-2 border-amber-400 flex items-center justify-center text-2xl gentle-float">
                        🏆
                    </div>
                    <div>
                        <span class="text-xs font-manga uppercase font-bold text-amber-700 tracking-wider block">BẢNG XẾP HẠNG CƯỜNG ĐỘ ĐIỆN TRƯỜNG (V/m)</span>
                        <h3 class="text-lg sm:text-2xl font-anime-title font-black text-slate-900 uppercase" id="hostLeaderboardRoundTitle">
                            TOP ĐỘI KỸ SƯ DẪN ĐẦU (CÂU 1)
                        </h3>
                    </div>
                </div>

                <button onclick="hostContinueToNextQuestion()" id="hostLeaderboardNextBtn" class="btn-cta-shine px-7 py-3 rounded-xl bg-gradient-to-r from-rose-500 via-sky-500 to-violet-600 text-white font-anime-title text-xs sm:text-sm uppercase tracking-wider transition shadow-lg flex items-center gap-2 font-black">
                    <span id="hostLeaderboardNextBtnText">CÂU HỎI TIẾP THEO</span>
                    <i class="fa-solid fa-arrow-right"></i>
                </button>
            </div>

            <!-- Bục vinh danh Top 3 mọc dần lên -->
            <div class="grid grid-cols-3 gap-3 sm:gap-5 items-end justify-center py-1 max-w-2xl mx-auto w-full">
                <div class="flex flex-col items-center podium-rise" style="animation-delay: 0.12s;">
                    <span class="text-2xl mb-1">🥈</span>
                    <div class="w-full p-2.5 rounded-xl bg-sky-50 border-2 border-sky-400 text-center flex flex-col items-center shadow-sm">
                        <span class="text-xs sm:text-base font-black text-slate-900 truncate max-w-full font-anime-title" id="podiumName2">--</span>
                        <span class="text-xs font-tech text-sky-700 font-black" id="podiumAlt2">0 V/m</span>
                    </div>
                    <div class="w-full h-12 bg-sky-100 rounded-b-lg flex items-center justify-center font-tech font-black text-sky-700 text-sm border border-sky-300">#2</div>
                </div>

                <div class="flex flex-col items-center podium-rise">
                    <span class="text-3xl mb-1 animate-bounce">👑 🥇</span>
                    <div class="w-full p-3.5 rounded-xl bg-amber-50 border-2 border-amber-400 text-center flex flex-col items-center shadow-md">
                        <span class="text-sm sm:text-lg font-black text-amber-800 truncate max-w-full font-anime-title" id="podiumName1">--</span>
                        <span class="text-xs sm:text-sm font-tech text-amber-700 font-black" id="podiumAlt1">0 V/m</span>
                    </div>
                    <div class="w-full py-4 bg-gradient-to-t from-amber-500 to-amber-300 rounded-b-lg flex items-center justify-center font-tech font-black text-amber-950 text-lg shadow">#1</div>
                </div>

                <div class="flex flex-col items-center podium-rise" style="animation-delay: 0.22s;">
                    <span class="text-2xl mb-1">🥉</span>
                    <div class="w-full p-2.5 rounded-xl bg-violet-50 border-2 border-violet-400 text-center flex flex-col items-center shadow-sm">
                        <span class="text-xs sm:text-base font-black text-slate-900 truncate max-w-full font-anime-title" id="podiumName3">--</span>
                        <span class="text-xs font-tech text-violet-700 font-black" id="podiumAlt3">0 V/m</span>
                    </div>
                    <div class="w-full h-9 bg-violet-100 rounded-b-lg flex items-center justify-center font-tech font-black text-violet-700 text-xs border border-violet-300">#3</div>
                </div>
            </div>

            <div class="bg-white rounded-2xl p-3.5 sm:p-4 border border-slate-200 overflow-hidden text-xs sm:text-sm shadow-sm">
                <table class="w-full text-left">

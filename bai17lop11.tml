    </main>

    <script>
        /* =========================================================================
           BỘ 10 CÂU HỎI TRẮC NGHIỆM – BÀI 17: KHÁI NIỆM ĐIỆN TRƯỜNG (VẬT LÍ 11 KNTT)
           ========================================================================= */
        const QUESTIONS_DATA = [
            {
                id: 1,
                category: "Câu 1. Nhận biết - Nguồn gốc tạo ra điện trường",
                title: "Điện trường được tạo ra bởi đối tượng nào?",
                options: [
                    "Điện tích.",
                    "Khối lượng.",
                    "Nhiệt độ.",
                    "Áp suất."
                ],
                correct: 0,
                simMode: "point_charge",
                isPositiveQ: true,
                chargeLabel: "Q > 0",
                formulaTag: "Điện trường tồn tại quanh điện tích",
                processLabel: "NGUỒN ĐIỆN TÍCH",
                explanation: "<b>Điện trường</b> là dạng vật chất bao quanh <b>điện tích</b> và gắn liền với điện tích. Điện trường tác dụng lực điện lên các điện tích khác đặt trong nó."
            },
            {
                id: 2,
                category: "Câu 2. Nhận biết - Đại lượng đặc trưng cho độ mạnh yếu điện trường",
                title: "Đại lượng nào đặc trưng cho độ mạnh yếu của điện trường tại một điểm?",
                options: [
                    "Điện lượng.",
                    "Cường độ điện trường.",
                    "Điện trở.",
                    "Công suất."
                ],
                correct: 1,
                simMode: "point_charge",
                isPositiveQ: true,
                chargeLabel: "Q > 0",
                formulaTag: "E = F / q (Đơn vị: V/m)",
                processLabel: "CƯỜNG ĐỘ ĐIỆN TRƯỜNG",
                explanation: "<b>Cường độ điện trường</b> tại một điểm là đại lượng đặc trưng cho tác dụng lực (độ mạnh yếu) của điện trường tại điểm đó, được đo bằng thương số $\\vec{E} = \\frac{\\vec{F}}{q}$ (đơn vị: $\\text{V/m}$)."
            },
            {
                id: 3,
                category: "Câu 3. Nhận biết - Quy ước xác định chiều vectơ cường độ điện trường",
                title: "Vectơ cường độ điện trường tại một điểm được xác định theo lực điện tác dụng lên:",
                options: [
                    "điện tích thử dương.",
                    "điện tích thử âm.",
                    "vật trung hòa.",
                    "nam châm."
                ],
                correct: 0,
                simMode: "point_charge",
                isPositiveQ: true,
                showTestCharge: true,
                chargeLabel: "Q > 0",
                formulaTag: "E⃗ cùng chiều lực điện tác dụng lên q > 0",
                processLabel: "ĐIỆN TÍCH THỬ DƯƠNG",
                explanation: "Từ hệ thức định nghĩa $\\vec{E} = \\frac{\\vec{F}}{q}$, vectơ cường độ điện trường $\\vec{E}$ tại một điểm luôn <b>cùng phương, cùng chiều với lực điện $\\vec{F}$ tác dụng lên điện tích thử dương ($q > 0$)</b> đặt tại điểm đó."
            },
            {
                id: 4,
                category: "Câu 4. Vận dụng - Tính độ lớn cường độ điện trường E = F/q",
                title: "Một điện tích thử dương $q = 2 \\times 10^{-6}\\text{ C}$ chịu lực điện $0,01\\text{ N}$. Độ lớn $E$ là:",
                options: [
                    "$200\\text{ V/m}$.",
                    "$2\\,000\\text{ V/m}$.",
                    "$5\\,000\\text{ V/m}$.",
                    "$20\\,000\\text{ V/m}$."
                ],
                correct: 2,
                simMode: "point_charge",
                isPositiveQ: true,
                showTestCharge: true,
                chargeLabel: "Q > 0",
                formulaTag: "E = F/q = 0,01 / (2×10⁻⁶) = 5000 V/m",
                processLabel: "TÍNH E = 5 000 V/m",
                explanation: "Áp dụng công thức tính độ lớn cường độ điện trường:<br>$$E = \\frac{F}{q} = \\frac{0,01}{2 \\times 10^{-6}} = 5\\,000\\text{ V/m}$$"
            },
            {
                id: 5,
                category: "Câu 5. Nhận biết - Chiều điện trường của điện tích điểm dương",
                title: "Điện trường do điện tích điểm $Q > 0$ gây ra có chiều:",
                options: [
                    "hướng về $Q$.",
                    "hướng ra xa $Q$.",
                    "luôn hướng lên.",
                    "luôn hướng xuống."
                ],
                correct: 1,
                simMode: "point_charge",
                isPositiveQ: true,
                chargeLabel: "Q > 0",
                formulaTag: "Q > 0 ⇒ Vectơ E⃗ hướng RA XA Q",
                processLabel: "ĐIỆN TÍCH DƯƠNG Q > 0",

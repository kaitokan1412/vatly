        /* =========================================================================
           HỆ THỐNG ÂM THANH TỔNG HỢP WEB AUDIO SYNTHESIZER (ZERO ASSET)
           ========================================================================= */
        let audioCtx = null;
        let sfxEnabled = true;

        function initAudio() {
            if (!audioCtx) {
                const AudioClass = window.AudioContext || window.webkitAudioContext;
                if (AudioClass) audioCtx = new AudioClass();
            }
            if (audioCtx && audioCtx.state === 'suspended') audioCtx.resume();
            return audioCtx;
        }

        const Sound = {
            playTone(freq, type, duration, gainVal = 0.08, delay = 0) {
                if (!sfxEnabled) return;
                try {
                    const ctx = initAudio();
                    if (!ctx) return;
                    const osc = ctx.createOscillator();
                    const gain = ctx.createGain();
                    osc.type = type;
                    osc.frequency.setValueAtTime(freq, ctx.currentTime + delay);
                    gain.gain.setValueAtTime(gainVal, ctx.currentTime + delay);
                    gain.gain.exponentialRampToValueAtTime(0.0001, ctx.currentTime + delay + duration);
                    osc.connect(gain);
                    gain.connect(ctx.destination);
                    osc.start(ctx.currentTime + delay);
                    osc.stop(ctx.currentTime + delay + duration);
                } catch(e) {}
            },
            tap() { this.playTone(880, 'sine', 0.04, 0.06); },
            correct() {
                [392.0, 493.88, 587.33, 783.99, 987.77].forEach((f, i) => {
                    this.playTone(f, 'triangle', 0.2, 0.1, i * 0.055);
                });
            },
            warningAlarm() {
                this.playTone(440, 'sawtooth', 0.14, 0.12, 0);
                this.playTone(370, 'sawtooth', 0.14, 0.12, 0.14);
                this.playTone(440, 'sawtooth', 0.18, 0.12, 0.28);
            },
            breakdownBlast() {
                this.playTone(125, 'sawtooth', 0.35, 0.32);
                this.playTone(62, 'sine', 0.42, 0.4, 0.05);
            },
            timerTick() { this.playTone(1180, 'sine', 0.03, 0.03); }
        };

        function toggleAudio() {
            sfxEnabled = !sfxEnabled;
            const icon = document.getElementById('sfxIcon');
            if (icon) {
                icon.className = sfxEnabled ? "fa-solid fa-volume-high text-sky-600 text-base" : "fa-solid fa-volume-xmark text-slate-400 text-base";
            }
        }

        function showToast(msg, isPositive = true) {
            const toast = document.getElementById('toastBox');
            if (!toast) return;
            toast.innerText = msg;
            toast.className = `fixed top-20 left-1/2 -translate-x-1/2 z-50 px-6 py-2.5 rounded-xl text-xs sm:text-sm font-black shadow-xl transition-all duration-300 opacity-100 ${
                isPositive ? 'bg-white text-sky-700 border-2 border-sky-400' : 'bg-rose-50 text-rose-700 border-2 border-rose-400'
            }`;
            setTimeout(() => {
                toast.classList.add('opacity-0', 'pointer-events-none');
            }, 2400);
        }

        function refreshMathRender() {
            if (typeof renderMathInElement === 'function') {
                try {
                    renderMathInElement(document.body, {
                        delimiters: [
                            { left: "$$", right: "$$", display: true },
                            { left: "$", right: "$", display: false }
                        ],
                        throwOnError: false
                    });
                } catch(e) {}
            } else {
                setTimeout(refreshMathRender, 200);
            }
        }

        function hideAllScreens() {
            document.querySelectorAll('main > section').forEach(sec => sec.classList.add('hidden'));
        }

        function renderHeaderStepDots(activeIdx) {
            const strip = document.getElementById('headerProgressStrip');
            const box = document.getElementById('headerStepDots');
            if (!strip || !box) return;
            strip.classList.remove('hidden');
            box.innerHTML = '';
            for (let i = 0; i < QUESTIONS_DATA.length; i++) {
                const dot = document.createElement('div');
                if (i < activeIdx) {
                    dot.className = "w-5 h-2 rounded-full bg-sky-500 transition-all duration-300";
                } else if (i === activeIdx) {
                    dot.className = "w-7 h-2.5 rounded-full bg-rose-500 animate-pulse shadow-sm";
                } else {
                    dot.className = "w-4 h-2 rounded-full bg-slate-300";
                }
                box.appendChild(dot);
            }
        }

        /* =========================================================================
           HỆ THỐNG TRUYỀN THÔNG HAI TẦNG: NETBUS (OFFLINE 2 TAB) + MQTT (INTERNET)
           ========================================================================= */
        const MQTT_BROKERS = [
            "wss://broker.emqx.io:8084/mqtt",
            "wss://broker.hivemq.com:8884/mqtt",
            "wss://test.mosquitto.org:8081/mqtt"
        ];
        let mqttClient = null;
        let roomPin = "";
        let isHost = false;

        function createMqttClient(clientId, onConnect, onMessage) {
            let currentIdx = 0;
            let client = null;
            let isConnected = false;
            let timeoutTimer = null;

            function connect() {
                if (client) {
                    try { client.end(true); } catch(e) {}
                }
                const url = MQTT_BROKERS[currentIdx];

                try {
                    client = mqtt.connect(url, {
                        clientId: clientId,
                        clean: true,
                        reconnectPeriod: 2500,
                        connectTimeout: 5000,
                        keepalive: 30
                    });

                    if (timeoutTimer) clearTimeout(timeoutTimer);
                    timeoutTimer = setTimeout(() => {
                        if (!isConnected && currentIdx < MQTT_BROKERS.length - 1) {
                            currentIdx++;
                            connect();
                        }
                    }, 5500);

                    client.on('connect', () => {
                        isConnected = true;
                        if (timeoutTimer) clearTimeout(timeoutTimer);
                        if (onConnect) onConnect(client);
                    });

                    client.on('message', (t, m) => {
                        if (onMessage) onMessage(t, m);
                    });

                    client.on('error', () => {
                        if (!isConnected && currentIdx < MQTT_BROKERS.length - 1) {
                            if (timeoutTimer) clearTimeout(timeoutTimer);
                            currentIdx++;
                            setTimeout(connect, 400);
                        }
                    });
                } catch(e) {
                    if (currentIdx < MQTT_BROKERS.length - 1) {
                        currentIdx++;
                        setTimeout(connect, 400);
                    }
                }
            }

            connect();
            return () => client;
        }

        const NetBus = {
            bc: null,
            init(pin, onMessage) {
                const chName = `electro_vector_bus_${pin}`;
                if (typeof BroadcastChannel !== 'undefined') {
                    try {
                        if (this.bc) {
                            try { this.bc.close(); } catch(e) {}
                        }
                        this.bc = new BroadcastChannel(chName);
                        this.bc.onmessage = (e) => {
                            if (e.data && onMessage) onMessage(e.data);
                        };
                    } catch(e) {}
                }

                window.addEventListener('storage', (e) => {
                    try {
                        if (e.key === chName && e.newValue) {
                            const parsed = JSON.parse(e.newValue);
                            if (parsed && parsed.payload && onMessage) {
                                onMessage(parsed.payload);
                            }
                        }
                    } catch(err) {}
                });
            },
            publish(pin, payload) {
                const chName = `electro_vector_bus_${pin}`;
                if (this.bc) {
                    try { this.bc.postMessage(payload); } catch(e) {}
                }
                try {
                    localStorage.setItem(chName, JSON.stringify({
                        payload: payload,
                        _t: Date.now() + Math.random()
                    }));
                } catch(e) {}
            }
        };

        /* =========================================================================
           TRẠNG THÁI GAME & QUẢN LÝ ĐỘI CHƠI
           ========================================================================= */
        let hostState = {
            players: {},
            currentQIndex: 0,
            timer: 30,
            timerInterval: null,
            isRoundEnded: false,
            isGameStarted: false,
            isFinished: false,
            botTimers: []
        };

        let storedPlayerId = sessionStorage.getItem('electro_player_id');
        if (!storedPlayerId) {
            storedPlayerId = "elc_" + Date.now().toString(36) + "_" + Math.random().toString(36).substring(2, 8);
            sessionStorage.setItem('electro_player_id', storedPlayerId);
        }

        let playerState = {
            playerId: storedPlayerId,
            myName: "",
            myClass: "",
            altitude: 0, // Cường độ điện trường tích lũy (V/m)
            score: 0,
            consecutiveWrong: 0,
            hazardState: 'normal',
            selectedChoice: null,
            timerInterval: null,
            joinInterval: null
        };

        /* =========================================================================
           MÔ PHỎNG ĐIỆN TRƯỜNG ĐA CHẾ ĐỘ TRÊN CANVAS 2D SÁNG RÕ & CHUYỂN ĐỘNG MƯỢT
           (1. Điện tích điểm Q • 2. Quy luật 1/r² • 3. Tổng hợp E1+E2 • 4. Đường sức)
           ========================================================================= */
        let simAnimFrame = null;
        let simSparks = [];
        let simPhase = 0;

        function triggerBurstSparks(cx, cy, colorList) {
            simSparks = [];
            for (let i = 0; i < 45; i++) {
                const angle = Math.random() * Math.PI * 2;
                const speed = 2 + Math.random() * 6;
                simSparks.push({
                    x: cx, y: cy,
                    vx: Math.cos(angle) * speed,
                    vy: Math.sin(angle) * speed,
                    life: 1.0,
                    size: 2.5 + Math.random() * 4,
                    color: colorList[Math.floor(Math.random() * colorList.length)]
                });
            }
        }

        function drawArrow(ctx, x1, y1, x2, y2, color, lineWidth = 3, headSize = 8) {
            const angle = Math.atan2(y2 - y1, x2 - x1);
            ctx.save();
            ctx.strokeStyle = color;
            ctx.fillStyle = color;
            ctx.lineWidth = lineWidth;
            ctx.lineCap = 'round';
            ctx.beginPath();
            ctx.moveTo(x1, y1);
            ctx.lineTo(x2, y2);
            ctx.stroke();

            ctx.beginPath();
            ctx.moveTo(x2, y2);
            ctx.lineTo(x2 - headSize * Math.cos(angle - Math.PI / 6), y2 - headSize * Math.sin(angle - Math.PI / 6));
            ctx.lineTo(x2 - headSize * Math.cos(angle + Math.PI / 6), y2 - headSize * Math.sin(angle + Math.PI / 6));
            ctx.closePath();
            ctx.fill();
            ctx.restore();
        }

        function drawChargeOrb(ctx, x, y, r, isPositive, labelText) {
            ctx.save();
            const grad = ctx.createRadialGradient(x - r * 0.3, y - r * 0.3, 2, x, y, r);
            if (isPositive) {
                grad.addColorStop(0, '#fb7185');
                grad.addColorStop(1, '#e11d48');
            } else {
                grad.addColorStop(0, '#38bdf8');
                grad.addColorStop(1, '#2563eb');
            }
            ctx.fillStyle = grad;
            ctx.shadowColor = isPositive ? 'rgba(225, 29, 72, 0.35)' : 'rgba(37, 99, 235, 0.35)';
            ctx.shadowBlur = 12;
            ctx.beginPath();
            ctx.arc(x, y, r, 0, Math.PI * 2);
            ctx.fill();

            ctx.lineWidth = 2.2;
            ctx.strokeStyle = '#ffffff';
            ctx.stroke();

            ctx.shadowBlur = 0;
            ctx.fillStyle = '#ffffff';
            ctx.font = `900 ${Math.round(r * 0.95)}px Orbitron, monospace`;
            ctx.textAlign = 'center';
            ctx.textBaseline = 'middle';
            ctx.fillText(isPositive ? '+' : '−', x, y + 1);

            if (labelText) {
                ctx.fillStyle = '#0f172a';
                ctx.font = 'bold 11.5px Orbitron, monospace';
                ctx.fillText(labelText, x, y + r + 15);
            }
            ctx.restore();
        }

        function runElectroCanvas(activeHazard = 'normal') {
            const canvas = document.getElementById('electroSimCanvas');
            if (!canvas) return;
            const ctx = canvas.getContext('2d');
            const rect = canvas.getBoundingClientRect();
            if (rect.width === 0 || rect.height === 0) return;

            canvas.width = rect.width * (window.devicePixelRatio || 1);
            canvas.height = rect.height * (window.devicePixelRatio || 1);
            ctx.scale(window.devicePixelRatio || 1, window.devicePixelRatio || 1);

            const w = rect.width;
            const h = rect.height;

            if (simAnimFrame) cancelAnimationFrame(simAnimFrame);

            const currentQ = QUESTIONS_DATA[hostState.currentQIndex] || QUESTIONS_DATA[0];
            const mode = currentQ.simMode || 'point_charge';

            const formulaTag = document.getElementById('simLiveFormulaTag');
            const modeText = document.getElementById('hostSimModeText');
            if (formulaTag) formulaTag.innerText = currentQ.formulaTag || "E = k·|Q|/r²";
            if (modeText) modeText.innerText = currentQ.processLabel || "ĐIỆN TRƯỜNG";

            function render() {
                simPhase += 0.04;
                ctx.clearRect(0, 0, w, h);

                // Nền phòng thí nghiệm sáng tinh tế
                const bgGrad = ctx.createLinearGradient(0, 0, w, h);
                bgGrad.addColorStop(0, '#ffffff');
                bgGrad.addColorStop(1, '#eef6ff');
                ctx.fillStyle = bgGrad;
                ctx.fillRect(0, 0, w, h);

                // Lưới tọa độ nhẹ
                ctx.strokeStyle = 'rgba(14, 165, 233, 0.09)';
                ctx.lineWidth = 1;
                for (let x = 0; x < w; x += 26) {
                    ctx.beginPath(); ctx.moveTo(x, 0); ctx.lineTo(x, h); ctx.stroke();
                }
                for (let y = 0; y < h; y += 26) {
                    ctx.beginPath(); ctx.moveTo(0, y); ctx.lineTo(w, y); ctx.stroke();
                }

                const cx = w * 0.5;
                const cy = h * 0.52;
                const jitter = activeHazard.startsWith('warning') ? (Math.random() - 0.5) * 5 : 0;

                if (mode === 'point_charge') {
                    // MÔ HÌNH 1 (BÀI 1 SGK): ĐIỆN TRƯỜNG CỦA 1 ĐIỆN TÍCH ĐIỂM Q & ĐIỂM M
                    const isPos = currentQ.isPositiveQ !== false;
                    const qx = w * 0.28 + jitter;
                    const qy = cy;

                    // 8 đường sức xuyên tâm chạy động (ra xa nếu Q>0, vào trong nếu Q<0)
                    for (let i = 0; i < 8; i++) {
                        const ang = (i * Math.PI) / 4;
                        const rStart = 24;
                        const rEnd = 74;
                        const sx = qx + rStart * Math.cos(ang);
                        const sy = qy + rStart * Math.sin(ang);
                        const ex = qx + rEnd * Math.cos(ang);
                        const ey = qy + rEnd * Math.sin(ang);

                        ctx.save();
                        ctx.strokeStyle = isPos ? 'rgba(225, 29, 72, 0.28)' : 'rgba(37, 99, 235, 0.28)';
                        ctx.lineWidth = 1.6;
                        ctx.setLineDash([6, 4]);
                        ctx.lineDashOffset = isPos ? (-simPhase * 14) : (simPhase * 14);
                        ctx.beginPath();
                        ctx.moveTo(sx, sy); ctx.lineTo(ex, ey);
                        ctx.stroke();
                        ctx.restore();
                    }

                    // Vòng sóng điện trường lan tỏa
                    const waveR = 22 + ((simPhase * 22) % 52);
                    ctx.strokeStyle = isPos
                        ? `rgba(244, 63, 94, ${Math.max(0, 0.35 - waveR / 210)})`
                        : `rgba(37, 99, 235, ${Math.max(0, 0.35 - waveR / 210)})`;
                    ctx.lineWidth = 2;
                    ctx.beginPath();
                    ctx.arc(qx, qy, isPos ? waveR : (74 - waveR + 22), 0, Math.PI * 2);
                    ctx.stroke();

                    drawChargeOrb(ctx, qx, qy, 20, isPos, currentQ.chargeLabel || (isPos ? 'Q > 0' : 'Q < 0'));

                    // Điểm khảo sát M bên phải
                    const mx = w * 0.66;
                    const my = cy;

                    // Đường nối r nét đứt
                    ctx.save();
                    ctx.strokeStyle = 'rgba(100, 116, 139, 0.45)';
                    ctx.setLineDash([5, 4]);
                    ctx.beginPath();
                    ctx.moveTo(qx + 22, qy); ctx.lineTo(mx, my);
                    ctx.stroke();
                    ctx.restore();

                    ctx.fillStyle = '#0f172a';
                    ctx.beginPath();
                    ctx.arc(mx, my, 5.5, 0, Math.PI * 2);
                    ctx.fill();
                    ctx.font = 'bold 12px Orbitron, monospace';
                    ctx.fillText(currentQ.showTestCharge ? 'M (+q)' : 'M', mx - 12, my + 22);

                    // Vectơ E tại M (hướng ra xa nếu Q>0, hướng về Q nếu Q<0)
                    const ePulse = 56 + Math.sin(simPhase * 2.2) * 5;
                    if (isPos) {
                        drawArrow(ctx, mx, my, mx + ePulse, my, '#0f172a', 3.4, 9);
                        ctx.fillStyle = '#e11d48';
                        ctx.fillText('E⃗', mx + ePulse - 6, my - 12);
                    } else {
                        drawArrow(ctx, mx, my, mx - ePulse, my, '#0f172a', 3.4, 9);
                        ctx.fillStyle = '#2563eb';
                        ctx.fillText('E⃗', mx - ePulse, my - 12);
                    }

                    ctx.fillStyle = '#334155';
                    ctx.font = 'bold 11px Nunito, sans-serif';
                    ctx.fillText(
                        isPos ? 'Điện tích Q > 0: Vectơ E⃗ hướng RA XA điện tích nguồn' : 'Điện tích Q < 0: Vectơ E⃗ hướng VÀO điện tích nguồn',
                        14, h - 12
                    );

                } else if (mode === 'inverse_square_E') {
                    // MÔ HÌNH 2 (CÂU 6): ĐIỆN TRƯỜNG TỈ LỆ NGHỊCH BÌNH PHƯƠNG KHOẢNG CÁCH (r → 3r, E giảm 9 lần)
                    const qx = 42;
                    const osc = (Math.sin(simPhase * 0.9) + 1) * 0.5; // 0 -> 1
                    const rDist = 48 + osc * (w - 150);
                    const mx = qx + rDist;
                    const factor = rDist / 48; // 1 -> ~3
                    const eRatio = 1 / (factor * factor);
                    const arrowLen = 12 + eRatio * 68;

                    ctx.save();
                    ctx.strokeStyle = 'rgba(100, 116, 139, 0.4)';
                    ctx.setLineDash([5, 4]);
                    ctx.beginPath(); ctx.moveTo(qx, cy + 8); ctx.lineTo(mx, cy + 8); ctx.stroke();
                    ctx.restore();

                    drawChargeOrb(ctx, qx, cy + 8, 18, true, 'Q');

                    ctx.fillStyle = '#0f172a';
                    ctx.beginPath(); ctx.arc(mx, cy + 8, 5, 0, Math.PI * 2); ctx.fill();
                    drawArrow(ctx, mx, cy + 8, mx + arrowLen, cy + 8, '#0284c7', 3.4, 8);
                    ctx.fillStyle = '#0369a1';
                    ctx.font = 'bold 11px Orbitron';
                    ctx.fillText('E⃗', mx + arrowLen - 4, cy - 4);

                    // Thanh đồng hồ đo cường độ E ~ 1/r²
                    const barW = 155;
                    ctx.fillStyle = '#e2e8f0';
                    ctx.fillRect(16, 14, barW, 13);
                    ctx.fillStyle = eRatio > 0.6 ? '#10b981' : (eRatio > 0.25 ? '#f59e0b' : '#8b5cf6');
                    ctx.fillRect(16, 14, barW * Math.min(1, eRatio), 13);
                    ctx.strokeStyle = '#64748b';
                    ctx.lineWidth = 1;
                    ctx.strokeRect(16, 14, barW, 13);

                    const liveE = Math.round(900 * eRatio);
                    ctx.fillStyle = '#0f172a';
                    ctx.font = 'bold 10.5px Orbitron, monospace';
                    ctx.fillText(`r = ${factor.toFixed(1)}r₀  •  E ≈ ${liveE} V/m`, 16, 42);

                    ctx.fillStyle = '#1e3a8a';
                    ctx.font = 'bold 11px Nunito, sans-serif';
                    ctx.fillText('Khi r tăng 3 lần (r → 3r) ⇒ E giảm 3² = 9 lần (900 → 100 V/m)', 14, h - 12);

                } else if (mode === 'vector_collinear') {
                    // MÔ HÌNH 3A (BÀI 2 & CÂU 8): TỔNG HỢP HAI VECTƠ ĐIỆN TRƯỜNG CÙNG CHIỀU (200 + 300 = 500)
                    const mx = 46;
                    const pulse = Math.sin(simPhase * 2) * 3;
                    const len1 = 68 + pulse;
                    const len2 = 102 + pulse;

                    ctx.fillStyle = '#0f172a';
                    ctx.beginPath(); ctx.arc(mx, cy, 5.5, 0, Math.PI * 2); ctx.fill();
                    ctx.font = 'bold 12px Orbitron';
                    ctx.fillText('M', mx - 18, cy + 4);

                    // E1 (200 V/m)
                    drawArrow(ctx, mx, cy - 22, mx + len1, cy - 22, '#e11d48', 3.2, 8);
                    ctx.fillStyle = '#be123c';
                    ctx.font = 'bold 10.5px Orbitron';
                    ctx.fillText('E⃗₁ (200)', mx + len1 + 6, cy - 18);

                    // E2 (300 V/m)
                    drawArrow(ctx, mx, cy + 4, mx + len2, cy + 4, '#0284c7', 3.2, 8);
                    ctx.fillStyle = '#0369a1';
                    ctx.fillText('E⃗₂ (300)', mx + len2 + 6, cy + 8);

                    // E tổng hợp (500 V/m)
                    const lenSum = Math.min(w - mx - 68, len1 + len2);
                    drawArrow(ctx, mx, cy + 34, mx + lenSum, cy + 34, '#7c3aed', 4.0, 10);
                    ctx.fillStyle = '#6d28d9';
                    ctx.fillText('E⃗ = E⃗₁ + E⃗₂ (500 V/m)', mx + 24, cy + 54);

                    ctx.fillStyle = '#334155';
                    ctx.font = 'bold 11px Nunito, sans-serif';
                    ctx.fillText('Hai vectơ cùng phương, cùng chiều: E = E₁ + E₂ = 500 V/m', 14, h - 12);

                } else if (mode === 'vector_perp') {
                    // MÔ HÌNH 3B (CÂU 9): TỔNG HỢP HAI VECTƠ ĐIỆN TRƯỜNG VUÔNG GÓC (300 & 400 → 500 V/m)
                    const ox = w * 0.28;
                    const oy = h * 0.72;
                    const len1 = 112; // 400 V/m ngang
                    const len2 = 84;  // 300 V/m đứng

                    // Hình chữ nhật quy tắc hình bình hành nét đứt
                    ctx.save();
                    ctx.strokeStyle = 'rgba(139, 92, 246, 0.45)';
                    ctx.setLineDash([5, 4]);
                    ctx.lineWidth = 1.6;
                    ctx.strokeRect(ox, oy - len2, len1, len2);
                    ctx.restore();

                    // Ký hiệu góc vuông
                    ctx.strokeStyle = '#64748b';
                    ctx.lineWidth = 1.5;
                    ctx.strokeRect(ox, oy - 14, 14, 14);

                    drawArrow(ctx, ox, oy, ox + len1, oy, '#0284c7', 3.2, 8);
                    drawArrow(ctx, ox, oy, ox, oy - len2, '#e11d48', 3.2, 8);
                    drawArrow(ctx, ox, oy, ox + len1, oy - len2, '#7c3aed', 4.0, 10);

                    ctx.fillStyle = '#0369a1';
                    ctx.font = 'bold 10.5px Orbitron';
                    ctx.fillText('E⃗₂ (400)', ox + len1 + 6, oy + 4);
                    ctx.fillStyle = '#be123c';
                    ctx.fillText('E⃗₁ (300)', ox - 52, oy - len2 + 4);
                    ctx.fillStyle = '#6d28d9';
                    ctx.fillText('E⃗ = 500 V/m', ox + len1 + 6, oy - len2 + 4);

                    ctx.fillStyle = '#334155';
                    ctx.font = 'bold 11px Nunito, sans-serif';
                    ctx.fillText('Vuông góc (E⃗₁ ⊥ E⃗₂): E = √(300² + 400²) = 500 V/m', 18, h - 12);

                } else {
                    // MÔ HÌNH 4 (CÂU 10): MẬT ĐỘ ĐƯỜNG SỨC ĐIỆN CỦA LƯỠNG CỰC (+ VÀ −)
                    const p1x = cx - 76;
                    const p2x = cx + 76;

                    [-68, -42, -20, 0, 20, 42, 68].forEach((curveY) => {
                        ctx.save();
                        ctx.strokeStyle = Math.abs(curveY) <= 20 ? '#0284c7' : 'rgba(2, 132, 199, 0.45)';
                        ctx.lineWidth = Math.abs(curveY) <= 20 ? 2.2 : 1.5;
                        ctx.setLineDash([7, 4]);
                        ctx.lineDashOffset = -simPhase * 15;
                        ctx.beginPath();
                        ctx.moveTo(p1x, cy);
                        ctx.quadraticCurveTo(cx, cy + curveY * 1.4, p2x, cy);
                        ctx.stroke();
                        ctx.restore();
                    });

                    drawChargeOrb(ctx, p1x, cy, 18, true, '+Q');
                    drawChargeOrb(ctx, p2x, cy, 18, false, '−Q');

                    // Nhãn minh họa vùng đường sức mau (gần điện tích) và thưa (xa điện tích)
                    ctx.fillStyle = '#be123c';
                    ctx.font = 'bold 10.5px Nunito, sans-serif';
                    ctx.fillText('Đường sức MAU ⇒ E mạnh', cx - 68, cy - 6);
                    ctx.fillStyle = '#475569';
                    ctx.fillText('Đường sức THƯA ⇒ E yếu', cx - 64, 22);
                    ctx.fillStyle = '#0f172a';
                    ctx.fillText('Đường sức đi từ (+) sang (−) và KHÔNG BAO GIỜ cắt nhau', 14, h - 12);
                }

                // Hạt hiệu ứng nổ/thưởng
                simSparks.forEach(sp => {
                    ctx.save();
                    ctx.globalAlpha = Math.max(0, sp.life);
                    ctx.fillStyle = sp.color;
                    ctx.beginPath(); ctx.arc(sp.x, sp.y, sp.size, 0, Math.PI * 2); ctx.fill();
                    ctx.restore();
                    sp.x += sp.vx; sp.y += sp.vy; sp.life -= 0.035;
                });
                simSparks = simSparks.filter(sp => sp.life > 0);

                simAnimFrame = requestAnimationFrame(render);
            }
            render();
        }

        window.addEventListener('resize', () => {
            const screen = document.getElementById('hostQuestionScreen');
            if (screen && !screen.classList.contains('hidden')) {
                runElectroCanvas('normal');
            }
        });

        function getElectroRankTitle(altitude) {
            if (altitude >= 800) return "👑 BẬC THẦY ĐIỆN TRƯỜNG MAXWELL";
            if (altitude >= 500) return "⭐ CHUYÊN GIA VECTƠ CƯỜNG ĐỘ E";
            if (altitude >= 200) return "⚡ KỸ SƯ ĐƯỜNG SỨC ĐIỆN";
            return "🔬 TẬP SỰ TĨNH ĐIỆN HỌC";
        }

        /* =========================================================================
           LOGIC MÁY CHIẾU (HOST CONTROLLER)
           ========================================================================= */
        function initHostMode() {
            isHost = true;
            hideAllScreens();
            document.getElementById('hostLobbyScreen').classList.remove('hidden');

            roomPin = Math.floor(1000 + Math.random() * 9000).toString();
            document.getElementById('hostPinDisplay').innerText = roomPin;
            document.getElementById('headerLivePin').innerText = roomPin;
            document.getElementById('headerPinBadge').classList.remove('hidden');

            generateHostQrCode();

            NetBus.init(roomPin, (msg) => {
                if (msg && msg._sender === 'player') {
                    handleHostIncomingData(msg.data);
                }
            });

            const clientId = "host_elc11_" + roomPin + "_" + Math.random().toString(36).substring(2, 6);
            createMqttClient(clientId, (client) => {
                mqttClient = client;
                mqttClient.subscribe(`electro_vector/${roomPin}/player`, { qos: 0 });
            }, (topic, message) => {
                try {
                    const data = JSON.parse(message.toString());
                    handleHostIncomingData(data);
                } catch(e) {}
            });
        }

        function hostPublish(data) {
            NetBus.publish(roomPin, { _sender: 'host', data: data });
            if (mqttClient && mqttClient.connected) {
                try {
                    mqttClient.publish(`electro_vector/${roomPin}/host`, JSON.stringify(data), { qos: 0 });
                } catch(e) {}
            }
        }

        function addDemoBots(count = 4) {
            const presets = [
                { name: "Vectơ Điện Trường", class: "11A1" },
                { name: "Đường Sức Faraday", class: "11A1" },
                { name: "Chồng Chất Maxwell", class: "11A2" },
                { name: "Điện Tích Thử 11A2", class: "11A2" }
            ];
            for (let i = 0; i < count; i++) {
                const p = presets[i % presets.length];
                const botId = "bot_" + (i + 1) + "_" + Math.random().toString(36).substring(2, 6);
                handleHostIncomingData({
                    type: 'PLAYER_JOIN',
                    playerId: botId,
                    name: p.name,
                    className: p.class,
                    isBot: true
                });
            }
            showToast(`✓ Đã bổ sung ${count} đội Bot mẫu!`, true);
        }

        function clearDemoBots() {
            hostState.players = {};
            updateHostLobbyUI();
            showToast("Đã làm mới danh sách đội!", true);
        }

        function updateHostLobbyUI() {
            const count = Object.keys(hostState.players).length;
            document.getElementById('hostPlayerCountNum').innerText = count;
            const container = document.getElementById('hostPlayerListContainer');
            const emptyMsg = document.getElementById('emptyPlayerMsg');
            const startBtn = document.getElementById('hostStartBtn');

            if (emptyMsg) emptyMsg.classList.toggle('hidden', count > 0);
            if (startBtn) startBtn.disabled = (count === 0);

            if (container) {
                container.innerHTML = '';
                Object.values(hostState.players).forEach((p, idx) => {
                    const tag = document.createElement('div');
                    tag.className = "px-3.5 py-1.5 rounded-xl bg-white border-2 border-sky-200 text-slate-800 font-bold text-xs flex items-center gap-2 shadow-sm";
                    tag.style.animation = `optPopIn 0.3s cubic-bezier(0.34, 1.56, 0.64, 1) ${Math.min(idx * 0.04, 0.4)}s both`;
                    tag.innerHTML = `<span>⚡</span> <span>${p.name}</span> <span class="text-sky-600">(${p.className})</span>`;
                    container.appendChild(tag);
                });
            }
        }

        function handleHostIncomingData(data) {
            if (!data || !data.type) return;

            if (data.type === 'PLAYER_JOIN') {
                const pId = data.playerId;
                if (!pId) return;

                if (!hostState.players[pId]) {
                    hostState.players[pId] = {
                        id: pId,
                        name: data.name || "Kỹ sư",
                        className: data.className || "11A",
                        isBot: Boolean(data.isBot),
                        altitude: 0,
                        score: 0,
                        consecutiveWrong: 0,
                        hazardState: 'normal',
                        correctCount: 0,
                        popCount: 0,
                        currentAnswer: null,
                        answerHistory: {}
                    };
                    Sound.tap();
                    updateHostLobbyUI();
                }

                hostPublish({
                    type: 'JOIN_ACK',
                    playerId: pId,
                    roomPin: roomPin
                });

                if (hostState.isGameStarted && !hostState.isFinished && !hostState.isRoundEnded) {
                    hostPublish({
                        type: 'QUESTION_START',
                        qIndex: hostState.currentQIndex,
                        playerId: pId
                    });
                }
            } else if (data.type === 'PLAYER_ANSWER') {
                const p = hostState.players[data.playerId];
                if (p && p.currentAnswer === null && !hostState.isRoundEnded) {
                    p.currentAnswer = data.choice;
                    const q = QUESTIONS_DATA[hostState.currentQIndex];
                    const isCorrect = (data.choice === q.correct);

                    p.answerHistory[hostState.currentQIndex] = {
                        choice: data.choice,
                        isCorrect: isCorrect
                    };

                    let altGain = 0;
                    if (isCorrect) {
                        p.correctCount++;
                        p.consecutiveWrong = 0;
                        p.hazardState = 'normal';
                        altGain = 100;
                        p.altitude = Math.min(1000, p.altitude + 100);
                        p.score += 100;
                    } else {
                        p.consecutiveWrong++;
                        if (p.consecutiveWrong === 1) {
                            p.hazardState = (hostState.currentQIndex % 2 === 0) ? 'warning_short' : 'warning_over';
                            altGain = -25;
                            p.altitude = Math.max(0, p.altitude - 25);
                        } else {
                            p.popCount++;
                            p.hazardState = (p.hazardState === 'warning_short') ? 'pop' : 'spike';
                            altGain = -75;
                            p.altitude = Math.max(0, p.altitude - 75);
                        }
                    }

                    const rankings = Object.values(hostState.players).sort((a, b) => b.altitude - a.altitude);
                    const myRank = rankings.findIndex(item => item.id === p.id) + 1;

                    hostPublish({
                        type: 'ROUND_FEEDBACK',
                        playerId: p.id,
                        isCorrect: isCorrect,
                        altGain: altGain,
                        altitude: p.altitude,
                        score: p.score,
                        hazardState: p.hazardState,
                        rank: myRank,
                        militaryRank: getElectroRankTitle(p.altitude),
                        totalPlayers: rankings.length
                    });

                    updateHostAnsweredCounter();
                    renderHostLiveSquadGrid();

                    const allPlayers = Object.values(hostState.players);
                    const answeredCount = allPlayers.filter(pl => pl.currentAnswer !== null).length;
                    if (answeredCount >= allPlayers.length && allPlayers.length > 0) {
                        hostEndQuestionRound();
                    }
                }
            }
        }

        function updateHostAnsweredCounter() {
            const answered = Object.values(hostState.players).filter(pl => pl.currentAnswer !== null).length;
            document.getElementById('hostAnsweredCount').innerText = answered;
        }

        function hostStartGame() {
            hostState.isGameStarted = true;
            hostState.currentQIndex = 0;
            hostPublish({ type: 'QUIZ_START' });
            hostLoadQuestion();
        }

        function hostLoadQuestion() {
            hideAllScreens();
            document.getElementById('hostQuestionScreen').classList.remove('hidden');
            document.getElementById('hostExplanationArea').classList.add('hidden');

            document.getElementById('simWarningAlert').classList.add('hidden');
            document.getElementById('simPopAlert').classList.add('hidden');
            document.getElementById('simSpikeAlert').classList.add('hidden');
            document.getElementById('simSuccessAlert').classList.add('hidden');

            hostState.isRoundEnded = false;
            const q = QUESTIONS_DATA[hostState.currentQIndex];

            renderHeaderStepDots(hostState.currentQIndex);

            document.getElementById('hostQCounterBadge').innerText = `CÂU ${hostState.currentQIndex + 1} / ${QUESTIONS_DATA.length}`;
            document.getElementById('hostQCategory').innerText = q.category;
            document.getElementById('hostQuestionTitle').innerText = q.title;

            for (let i = 0; i < 4; i++) {
                document.getElementById(`hostOptText${i}`).innerHTML = q.options[i];
                const card = document.getElementById(`hostOptCard${i}`);
                const badge = document.getElementById(`hostOptBadge${i}`);
                const statWrap = document.getElementById(`hostOptStatWrap${i}`);
                badge.classList.add('hidden');
                statWrap.classList.add('hidden');
                card.classList.remove('ring-4', 'ring-emerald-500', 'opacity-45', 'correct-pop', `opt-stagger-${i}`);
                void card.offsetWidth;
                card.classList.add(`opt-stagger-${i}`);
            }

            Object.values(hostState.players).forEach(p => {
                p.currentAnswer = null;
            });

            document.getElementById('hostTotalPlayersCount').innerText = Object.keys(hostState.players).length;
            document.getElementById('hostAnsweredCount').innerText = "0";

            renderHostLiveSquadGrid();
            refreshMathRender();

            const players = Object.values(hostState.players);
            const avgE = players.length > 0 ? Math.round(players.reduce((sum, p) => sum + p.altitude, 0) / players.length) : 0;
            document.getElementById('hostAvgAltText').innerText = `${avgE} V/m`;
            runElectroCanvas('normal');

            hostPublish({
                type: 'QUESTION_START',
                qIndex: hostState.currentQIndex
            });

            hostState.botTimers.forEach(t => clearTimeout(t));
            hostState.botTimers = [];
            const bots = Object.values(hostState.players).filter(p => p.isBot);
            bots.forEach(bot => {
                const delay = 2200 + Math.random() * 7000;
                const isCorrect = Math.random() < 0.8;
                const botChoice = isCorrect ? q.correct : (q.correct + 1) % 4;
                const timer = setTimeout(() => {
                    if (!hostState.isRoundEnded && bot.currentAnswer === null) {
                        handleHostIncomingData({
                            type: 'PLAYER_ANSWER',
                            playerId: bot.id,
                            choice: botChoice
                        });
                    }
                }, delay);
                hostState.botTimers.push(timer);
            });

            hostState.timer = 30;
            document.getElementById('hostTimerText').innerText = hostState.timer;
            document.getElementById('hostTimerBar').style.width = "100%";
            const timerWrap = document.getElementById('hostTimerWrap');
            if (timerWrap) timerWrap.classList.remove('timer-urgent');

            clearInterval(hostState.timerInterval);
            hostState.timerInterval = setInterval(() => {
                hostState.timer--;
                document.getElementById('hostTimerText').innerText = hostState.timer;
                document.getElementById('hostTimerBar').style.width = `${Math.max(0, (hostState.timer / 30) * 100)}%`;
                if (hostState.timer <= 5 && hostState.timer > 0) {
                    Sound.timerTick();
                    if (timerWrap) timerWrap.classList.add('timer-urgent');
                }
                if (hostState.timer <= 0) {
                    hostEndQuestionRound();
                }
            }, 1000);
        }

        function hostEndQuestionRound() {
            if (hostState.isRoundEnded) return;
            hostState.isRoundEnded = true;
            clearInterval(hostState.timerInterval);
            const timerWrap = document.getElementById('hostTimerWrap');
            if (timerWrap) timerWrap.classList.remove('timer-urgent');

            hostState.botTimers.forEach(t => clearTimeout(t));
            hostState.botTimers = [];

            const q = QUESTIONS_DATA[hostState.currentQIndex];
            const players = Object.values(hostState.players);
            const totalAnswered = Math.max(1, players.filter(p => p.currentAnswer !== null).length);

            for (let i = 0; i < 4; i++) {
                const card = document.getElementById(`hostOptCard${i}`);
                const badge = document.getElementById(`hostOptBadge${i}`);
                const statWrap = document.getElementById(`hostOptStatWrap${i}`);
                const bar = document.getElementById(`hostOptBar${i}`);

                const pickCount = players.filter(p => p.currentAnswer === i).length;
                const pct = Math.round((pickCount / totalAnswered) * 100);
                statWrap.classList.remove('hidden');
                bar.style.width = `${pct}%`;

                if (i === q.correct) {
                    card.classList.add('ring-4', 'ring-emerald-500', 'correct-pop');
                    badge.innerText = `✓ ĐÚNG (${pct}%)`;
                    badge.classList.remove('hidden');
                } else {
                    card.classList.add('opacity-45');
                }
            }

            let worstHazard = 'normal';
            if (players.some(p => p.hazardState === 'pop')) worstHazard = 'pop';
            else if (players.some(p => p.hazardState === 'spike')) worstHazard = 'spike';
            else if (players.some(p => p.hazardState === 'warning_short')) worstHazard = 'warning_short';
            else if (players.some(p => p.hazardState === 'warning_over')) worstHazard = 'warning_over';

            const avgE = players.length > 0 ? Math.round(players.reduce((sum, p) => sum + p.altitude, 0) / players.length) : 0;
            document.getElementById('hostAvgAltText').innerText = `${avgE} V/m`;

            const canvas = document.getElementById('electroSimCanvas');
            const rect = canvas ? canvas.getBoundingClientRect() : { width: 300, height: 240 };

            if (worstHazard === 'pop') {
                document.getElementById('simPopAlert').classList.remove('hidden');
                triggerBurstSparks(rect.width / 2, rect.height / 2, ['#f43f5e', '#f59e0b', '#8b5cf6']);
                Sound.breakdownBlast();
            } else if (worstHazard === 'spike') {
                document.getElementById('simSpikeAlert').classList.remove('hidden');
                Sound.breakdownBlast();
            } else if (worstHazard.startsWith('warning')) {
                document.getElementById('simWarningAlert').classList.remove('hidden');
                Sound.warningAlarm();
            } else {
                document.getElementById('simSuccessAlert').classList.remove('hidden');
                triggerBurstSparks(rect.width / 2, rect.height / 2, ['#10b981', '#0ea5e9', '#f43f5e']);
                Sound.correct();
            }

            runElectroCanvas(worstHazard);

            document.getElementById('hostExplanationText').innerHTML = q.explanation;
            document.getElementById('hostExplanationArea').classList.remove('hidden');
            refreshMathRender();
        }

        function renderHostLiveSquadGrid() {
            const grid = document.getElementById('hostLiveSquadGrid');
            if (!grid) return;
            grid.innerHTML = '';
            Object.values(hostState.players).forEach(p => {
                const card = document.createElement('div');
                const isAnswered = p.currentAnswer !== null;
                card.className = `px-2.5 py-1.5 rounded-lg border text-[11px] flex items-center justify-between font-bold transition-all duration-300 ${
                    isAnswered ? 'bg-sky-50 border-sky-400 text-sky-900 shadow-sm' : 'bg-white border-slate-200 text-slate-500'
                }`;
                card.innerHTML = `
                    <span class="truncate max-w-[85px]">${isAnswered ? '✓' : '•'} ${p.name}</span>
                    <span class="font-tech text-violet-600">${p.altitude}</span>
                `;
                grid.appendChild(card);
            });
        }

        function hostShowLeaderboardScreen() {
            hideAllScreens();
            document.getElementById('hostLeaderboardScreen').classList.remove('hidden');

            const sorted = Object.values(hostState.players).sort((a, b) => b.altitude - a.altitude);

            document.getElementById('hostLeaderboardRoundTitle').innerText = `TOP ĐỘI DẪN ĐẦU (SAU CÂU ${hostState.currentQIndex + 1})`;

            [1, 2, 3].forEach(pos => {
                const pl = sorted[pos - 1];
                document.getElementById(`podiumName${pos}`).innerText = pl ? pl.name : "--";
                document.getElementById(`podiumAlt${pos}`).innerText = pl ? `${pl.altitude} V/m` : "0 V/m";
            });

            const tbody = document.getElementById('hostTopTableBody');
            tbody.innerHTML = '';
            sorted.forEach((p, idx) => {
                const tr = document.createElement('tr');
                tr.className = idx === 0 ? "bg-amber-50/90" : "hover:bg-slate-50 transition";
                tr.innerHTML = `
                    <td class="p-3 font-tech text-amber-600">#${idx + 1}</td>
                    <td class="p-3 font-black text-slate-900">⚡ ${p.name}</td>
                    <td class="p-3 text-slate-500">${p.className}</td>
                    <td class="p-3 text-center font-manga text-xs text-sky-700">${getElectroRankTitle(p.altitude)}</td>
                    <td class="p-3 text-center font-tech text-rose-600">${p.correctCount}/${hostState.currentQIndex + 1}</td>
                    <td class="p-3 text-right font-tech font-black text-violet-700">${p.altitude} V/m</td>
                `;
                tbody.appendChild(tr);
            });

            hostPublish({
                type: 'SHOW_LEADERBOARD',
                rankings: sorted.map((pl, i) => ({
                    rank: i + 1,
                    name: pl.name,
                    altitude: pl.altitude,
                    score: pl.score
                }))
            });

            Sound.tap();
        }

        function hostContinueToNextQuestion() {
            hostState.botTimers.forEach(t => clearTimeout(t));
            hostState.botTimers = [];
            hostState.currentQIndex++;
            if (hostState.currentQIndex >= QUESTIONS_DATA.length) {
                hostShowFinalResults();
            } else {
                hostLoadQuestion();
            }
        }

        function hostShowFinalResults() {
            hostState.isFinished = true;
            hideAllScreens();
            document.getElementById('hostFinalScreen').classList.remove('hidden');

            Sound.correct();
            if (typeof confetti === 'function') {
                confetti({ particleCount: 160, spread: 95, origin: { y: 0.6 } });
            }

            const sorted = Object.values(hostState.players).sort((a, b) => b.altitude - a.altitude);
            const champ = sorted[0];

            if (champ) {
                document.getElementById('hostFinalChampionAnnounce').innerHTML = `
                    Bậc thầy Điện trường: <b class="text-sky-700 text-lg">${champ.name}</b> (${champ.className}) đạt <b>${champ.altitude} V/m</b> (${champ.correctCount}/${QUESTIONS_DATA.length} câu đúng)!
                `;
            }

            const tbody = document.getElementById('hostFinalStatsTbody');
            tbody.innerHTML = '';
            sorted.forEach((p, idx) => {
                const tr = document.createElement('tr');
                tr.className = idx === 0 ? "bg-amber-50/90" : "hover:bg-slate-50 transition";
                tr.innerHTML = `
                    <td class="p-3 font-tech text-amber-600">#${idx + 1}</td>
                    <td class="p-3 font-black text-slate-900">${p.name} ${idx === 0 ? '👑' : ''}</td>
                    <td class="p-3 text-slate-500">${p.className}</td>
                    <td class="p-3 text-center font-tech text-violet-700 font-black">${p.altitude} V/m</td>
                    <td class="p-3 text-center font-tech text-sky-700">${p.correctCount}/${QUESTIONS_DATA.length}</td>
                    <td class="p-3 text-center font-tech text-rose-600">${p.popCount}</td>
                    <td class="p-3 text-right font-tech font-black text-emerald-700">${p.score}</td>
                `;
                tbody.appendChild(tr);
            });

            hostPublish({ type: 'QUIZ_FINISHED' });
        }

        function exportQuizExcel() {
            const players = Object.values(hostState.players);
            if (players.length === 0) {
                showToast("Chưa có dữ liệu học sinh để xuất Excel!", false);
                return;
            }
            const excelRows = players.map((p, idx) => ({
                "STT": idx + 1,
                "Tên Đội / Học Sinh": p.name,
                "Lớp": p.className,
                "Cường Độ Điện Trường (V/m)": p.altitude,
                "Danh Hiệu": getElectroRankTitle(p.altitude),
                "Số Câu Đúng": `${p.correctCount}/${QUESTIONS_DATA.length}`,
                "Số Lần Đánh Thủng": p.popCount,
                "Tổng Điểm": p.score
            }));

            const wb = XLSX.utils.book_new();
            const ws = XLSX.utils.json_to_sheet(excelRows);
            XLSX.utils.book_append_sheet(wb, ws, "KetQua_Bai17_DienTruong");
            XLSX.writeFile(wb, "KetQua_TracNghiem_Bai17_KhaiNiemDienTruong_VatLi11.xlsx");
            showToast("✓ Đã tải xuống file Excel bảng điểm!", true);
        }

        function generateHostQrCode() {
            const qrBox = document.getElementById('hostQrCodeBox');
            const modalBox = document.getElementById('modalQrCodeBox');
            if (!qrBox) return;
            qrBox.innerHTML = '';
            if (modalBox) modalBox.innerHTML = '';

            document.getElementById('modalPinText').innerText = roomPin;
            const joinUrl = window.location.origin + window.location.pathname + `?pin=${roomPin}`;

            try {
                if (typeof QRCode !== 'undefined') {
                    new QRCode(qrBox, { text: joinUrl, width: 136, height: 136, colorDark: "#0284c7", colorLight: "#ffffff" });
                    if (modalBox) {
                        new QRCode(modalBox, { text: joinUrl, width: 210, height: 210, colorDark: "#0284c7", colorLight: "#ffffff" });
                    }
                }
            } catch(e) {}
        }

        function copyJoinLink() {
            const url = window.location.origin + window.location.pathname + `?pin=${roomPin}`;
            const el = document.createElement('textarea');
            el.value = url;
            document.body.appendChild(el);
            el.select();
            document.execCommand('copy');
            document.body.removeChild(el);
            showToast("✓ Đã sao chép đường dẫn vào phòng!", true);
        }

        function openQrModal() { document.getElementById('qrModal').classList.remove('hidden'); }
        function closeQrModal() { document.getElementById('qrModal').classList.add('hidden'); }

        /* =========================================================================
           LOGIC TAY CẦM ĐIỆN THOẠI HỌC SINH (PLAYER CONTROLLER)
           ========================================================================= */
        function initPlayerMode() {
            isHost = false;
            hideAllScreens();
            document.getElementById('playerJoinScreen').classList.remove('hidden');

            const params = new URLSearchParams(window.location.search);
            if (params.get('pin')) {
                document.getElementById('playerPinInput').value = params.get('pin').trim();
            }
            const savedName = sessionStorage.getItem('electro_saved_name');
            const savedClass = sessionStorage.getItem('electro_saved_class');
            if (savedName) document.getElementById('playerNameInput').value = savedName;
            if (savedClass) document.getElementById('playerClassInput').value = savedClass;
        }

        function playerJoinRoom() {
            const pin = document.getElementById('playerPinInput').value.trim().replace(/\s+/g, '');
            const name = document.getElementById('playerNameInput').value.trim();
            const className = document.getElementById('playerClassInput').value.trim() || "11A";
            const statusMsg = document.getElementById('playerConnectStatusMsg');
            const submitBtn = document.getElementById('btnPlayerJoinSubmit');

            if (!pin || !name) {
                showToast("Vui lòng nhập Mã PIN và Tên đội!", false);
                return;
            }

            roomPin = pin;
            playerState.myName = name;
            playerState.myClass = className;
            playerState.altitude = 0;
            playerState.score = 0;

            sessionStorage.setItem('electro_saved_name', name);
            sessionStorage.setItem('electro_saved_class', className);

            document.getElementById('playerMyNameDisplay').innerText = `${name} (${className})`;
            document.getElementById('playerNavName').innerText = name;
            document.getElementById('playerAltHUD').innerText = "0 V/m";

            statusMsg.innerText = "Đang kết nối vào Phòng thí nghiệm Điện trường...";
            statusMsg.classList.remove('hidden');
            submitBtn.disabled = true;

            if (playerState.joinInterval) {
                clearInterval(playerState.joinInterval);
                playerState.joinInterval = null;
            }

            NetBus.init(roomPin, (msg) => {
                if (msg && msg._sender === 'host') {
                    handlePlayerIncomingData(msg.data);
                }
            });

            const sendJoin = () => {
                playerPublish({
                    type: 'PLAYER_JOIN',
                    playerId: playerState.playerId,
                    name: playerState.myName,
                    className: playerState.myClass
                });
            };

            sendJoin();

            const clientId = "pl_elc11_" + roomPin + "_" + playerState.playerId.slice(-6) + "_" + Math.random().toString(36).substring(2, 6);
            if (mqttClient) try { mqttClient.end(true); } catch(e) {}

            createMqttClient(clientId, (client) => {
                mqttClient = client;
                mqttClient.subscribe(`electro_vector/${roomPin}/host`, { qos: 0 }, (err) => {
                    if (!err) sendJoin();
                });
            }, (topic, message) => {
                try {
                    const data = JSON.parse(message.toString());
                    handlePlayerIncomingData(data);
                } catch(e) {}
            });

            let attempts = 0;
            playerState.joinInterval = setInterval(() => {
                attempts++;
                if (attempts > 20) {
                    clearInterval(playerState.joinInterval);
                    playerState.joinInterval = null;
                    statusMsg.innerText = "❌ Không tìm thấy phòng! Hãy kiểm tra lại Mã PIN trên máy chiếu.";
                    submitBtn.disabled = false;
                    return;
                }
                sendJoin();
            }, 1000);
        }

        function playerPublish(data) {
            NetBus.publish(roomPin, { _sender: 'player', data: data });
            if (mqttClient && mqttClient.connected) {
                try {
                    mqttClient.publish(`electro_vector/${roomPin}/player`, JSON.stringify(data), { qos: 0 });
                } catch(e) {}
            }
        }

        function handlePlayerIncomingData(data) {
            if (!data || !data.type) return;

            if (data.type === 'JOIN_ACK' && data.playerId === playerState.playerId) {
                if (playerState.joinInterval) {
                    clearInterval(playerState.joinInterval);
                    playerState.joinInterval = null;
                }
                hideAllScreens();
                document.getElementById('playerLobbyScreen').classList.remove('hidden');
                Sound.tap();
            } else if (data.type === 'QUESTION_START') {
                if (data.playerId && data.playerId !== playerState.playerId) return;

                hideAllScreens();
                document.getElementById('playerGamepadScreen').classList.remove('hidden');
                document.getElementById('playerSubmittedOverlay').classList.add('hidden');
                document.getElementById('playerMcqContainer').classList.remove('hidden');

                const q = QUESTIONS_DATA[data.qIndex || 0];
                document.getElementById('playerQCounter').innerText = `CÂU ${(data.qIndex || 0) + 1} / ${QUESTIONS_DATA.length}`;
                document.getElementById('playerQuestionTitle').innerText = q.title;

                for (let i = 0; i < 4; i++) {
                    document.getElementById(`playerOptText${i}`).innerHTML = q.options[i];
                    document.getElementById(`playerBtn${i}`).disabled = false;
                }

                playerState.selectedChoice = null;

                let timer = 30;
                document.getElementById('playerTimerText').innerText = `${timer}s`;
                clearInterval(playerState.timerInterval);
                playerState.timerInterval = setInterval(() => {
                    timer--;
                    if (timer >= 0) {
                        document.getElementById('playerTimerText').innerText = `${timer}s`;
                    } else {
                        clearInterval(playerState.timerInterval);
                    }
                }, 1000);

                refreshMathRender();
            } else if (data.type === 'ROUND_FEEDBACK' && data.playerId === playerState.playerId) {
                clearInterval(playerState.timerInterval);
                hideAllScreens();
                document.getElementById('playerFeedbackScreen').classList.remove('hidden');

                playerState.altitude = data.altitude;
                playerState.score = data.score;
                document.getElementById('playerAltHUD').innerText = `${data.altitude} V/m`;

                const title = document.getElementById('playerFeedbackTitle');
                const gain = document.getElementById('playerFeedbackGain');
                const icon = document.getElementById('playerFeedbackIcon');

                if (data.isCorrect) {
                    Sound.correct();
                    icon.innerText = "⚡✨";
                    title.innerText = "ĐO VECTƠ E CHUẨN XÁC!";
                    title.className = "text-lg sm:text-xl font-anime-title font-black text-emerald-600 uppercase";
                    gain.innerText = `+${data.altGain} V/m • Xác định điện trường chính xác tuyệt đối!`;
                } else {
                    if (data.hazardState === 'pop' || data.hazardState === 'spike') {
                        Sound.breakdownBlast();
                        icon.innerText = "💥";
                        title.innerText = "ĐÁNH THỦNG ĐIỆN MÔI!";
                        title.className = "text-lg sm:text-xl font-anime-title font-black text-rose-600 uppercase";
                        gain.innerText = `${data.altGain} V/m • Sai liên tiếp làm sụt cường độ điện trường!`;
                    } else {
                        Sound.warningAlarm();
                        icon.innerText = "⚠️";
                        title.innerText = "NHIỄU LOẠN ĐIỆN TRƯỜNG!";
                        title.className = "text-lg sm:text-xl font-anime-title font-black text-amber-600 uppercase";
                        gain.innerText = `${data.altGain} V/m • Kiểm tra lại dấu Q và công thức E = k|Q|/r²!`;
                    }
                }

                document.getElementById('playerMyRankNum').innerText = `#${data.rank || '--'}`;
                document.getElementById('playerTotalPlayersBadge').innerText = `/ ${data.totalPlayers || '--'} đội`;
                document.getElementById('playerRankHUD').innerText = `#${data.rank || '--'}`;
                document.getElementById('playerRankStatusText').innerText = data.militaryRank || getElectroRankTitle(data.altitude);
            } else if (data.type === 'SHOW_LEADERBOARD') {
                hideAllScreens();
                document.getElementById('playerLeaderboardScreen').classList.remove('hidden');

                const container = document.getElementById('playerTopListContainer');
                if (container && data.rankings) {
                    container.innerHTML = '';
                    let myRankInBoard = null;
                    data.rankings.forEach(pl => {
                        const row = document.createElement('div');
                        const isMe = (pl.name === playerState.myName);
                        if (isMe) myRankInBoard = pl.rank;

                        row.className = `p-2.5 rounded-xl border flex items-center justify-between text-xs font-bold ${
                            isMe ? 'bg-sky-50 border-sky-400 text-sky-900 shadow-sm' : 'bg-white border-slate-200 text-slate-700'
                        }`;
                        row.innerHTML = `
                            <div class="flex items-center gap-2">
                                <span class="font-tech text-amber-600">#${pl.rank}</span>
                                <span class="font-black text-slate-900">${pl.name}</span>
                            </div>
                            <span class="font-tech text-violet-700">${pl.altitude} V/m</span>
                        `;
                        container.appendChild(row);
                    });

                    document.getElementById('playerMobileMyRankSummary').innerText = `${myRankInBoard ? '#' + myRankInBoard : 'Ngoài bảng'} (${playerState.altitude} V/m)`;
                }
            } else if (data.type === 'QUIZ_FINISHED') {
                clearInterval(playerState.timerInterval);
                hideAllScreens();
                document.getElementById('playerLobbyScreen').classList.remove('hidden');
                document.getElementById('playerMyNameDisplay').innerText = `Hoàn thành thí nghiệm: ${playerState.altitude} V/m!`;
            }
        }

        function playerSubmitAnswer(choiceIdx) {
            if (playerState.selectedChoice !== null) return;
            playerState.selectedChoice = choiceIdx;

            const labels = ['A', 'B', 'C', 'D'];
            document.getElementById('playerMcqContainer').classList.add('hidden');
            document.getElementById('playerSubmittedOverlay').classList.remove('hidden');
            document.getElementById('playerSubmittedLabel').innerText = `Đã khóa phương án [${labels[choiceIdx]}]!`;

            Sound.tap();

            playerPublish({
                type: 'PLAYER_ANSWER',
                playerId: playerState.playerId,
                choice: choiceIdx
            });
        }

        window.addEventListener('DOMContentLoaded', () => {
            refreshMathRender();
            const params = new URLSearchParams(window.location.search);
            if (params.get('pin')) {
                initPlayerMode();
            }
        });
    </script>
</body>
</html>

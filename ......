        function hostNextQuestion() {
            hostState.currentQIndex++;
            const aliveCount = Object.values(hostState.players).filter(p => p.isAlive).length;

            if (hostState.bossCurrentHp <= 0 || hostState.currentQIndex >= QUESTIONS_DATA.length || aliveCount === 0) {
                hostShowFinalPodiumAndStats();
            } else {
                hostLoadQuestion();
            }
        }

        function hostShowFinalPodiumAndStats() {
            hideAllScreens();
            document.getElementById('hostFinalScreen').classList.remove('hidden');

            const isBossDefeated = hostState.bossCurrentHp <= 0;
            const finalTitle = document.getElementById('hostFinalMainTitle');
            const finalSub = document.getElementById('hostFinalSubTitle');
            const finalIcon = document.getElementById('finalStatusIcon');

            if (isBossDefeated) {
                finalTitle.innerText = "CHÚC MỪNG CÁC BẠN ĐÃ CHINH PHẠT THÀNH CÔNG";
                finalTitle.className = "text-2xl sm:text-4xl font-rpg font-black text-transparent bg-clip-text bg-gradient-to-r from-emerald-300 via-yellow-200 to-amber-400 uppercase";
                finalSub.innerText = `Thực Thể Nguyên Tố đã bị tiêu diệt hoàn toàn! Vinh danh các đại hiệp sĩ xuất sắc nhất!`;
                finalIcon.innerText = "🏆";
                Sound.victory();

                if (typeof confetti === 'function') {
                    confetti({ particleCount: 160, spread: 90, origin: { y: 0.6 } });
                }
            } else {
                finalTitle.innerText = "CÁC BẠN ĐÃ TIÊU DIỆT MỤC TIÊU THẤT BẠI";
                finalTitle.className = "text-2xl sm:text-4xl font-rpg font-black text-transparent bg-clip-text bg-gradient-to-r from-rose-400 via-red-400 to-orange-400 uppercase";
                finalSub.innerText = `Thực Thể vẫn còn ${hostState.bossCurrentHp.toLocaleString()} HP. Hãy củng cố kiến thức và thử thách lại!`;
                finalIcon.innerText = "💀";
                Sound.defeat();
            }

            const sorted = Object.values(hostState.players).sort((a, b) => {
                if (a.isAlive !== b.isAlive) return a.isAlive ? -1 : 1;
                return b.atk - a.atk;
            });

            let fastestKnight = null;
            let minAvgTime = 9999;
            sorted.forEach(p => {
                const avg = p.questionsAnswered > 0 ? (p.totalResponseTime / p.questionsAnswered) : 999;
                if (avg < minAvgTime) {
                    minAvgTime = avg;
                    fastestKnight = p;
                }
            });

            if (fastestKnight) {
                document.getElementById('hostFastestTeamName').innerText = `⚡ ${fastestKnight.name} (Hệ ${fastestKnight.elementConfig.name} - ${fastestKnight.className})`;
                document.getElementById('hostFastestTimeVal').innerText = `${minAvgTime.toFixed(2)} giây / câu`;
            }

            // Bảng 1: Thống kê tổng hợp
            const tbodyStats = document.getElementById('hostStatsTableBody');
            tbodyStats.innerHTML = '';

            sorted.forEach((p, idx) => {
                const avgSpeed = p.questionsAnswered > 0 ? (p.totalResponseTime / p.questionsAnswered).toFixed(2) : "0.00";
                const acc = Math.round((p.correctCount / QUESTIONS_DATA.length) * 100);
                const tr = document.createElement('tr');
                tr.className = p.isAlive ? "bg-purple-950/40 text-purple-200" : "text-slate-400";
                tr.innerHTML = `
                    <td class="p-2.5 font-rpg">#${idx+1}</td>
                    <td class="p-2.5 font-bold flex items-center gap-1.5">${p.elementConfig.emoji} <span>${p.name} (${p.className})</span> ${idx===0&&p.isAlive?'👑':''}</td>
                    <td class="p-2.5"><span class="px-2 py-0.5 rounded-lg text-xs font-bold ${p.isAlive ? 'bg-emerald-500/20 text-emerald-300 border border-emerald-500/40' : 'bg-red-500/20 text-red-400 border border-red-500/40'}">${p.isAlive ? 'Sống Sót' : 'Bị Hạ (K.O)'}</span></td>
                    <td class="p-2.5 text-center font-ui font-black text-yellow-300">${p.atk}</td>
                    <td class="p-2.5 text-center font-ui font-black ${p.hp > 0 ? 'text-emerald-400' : 'text-red-500'}">${p.hp}</td>
                    <td class="p-2.5 text-center">${p.correctCount}/${QUESTIONS_DATA.length}</td>
                    <td class="p-2.5 text-center font-mono text-cyan-300">${avgSpeed}s</td>
                    <td class="p-2.5 text-right font-bold text-emerald-400">${acc}%</td>
                `;
                tbodyStats.appendChild(tr);
            });

            // Bảng 2: Ma trận Đúng / Sai
            const matrixHeaderRow = document.getElementById('hostMatrixHeaderRow');
            matrixHeaderRow.innerHTML = '<th class="p-2 text-left rounded-l-xl">Tên Đội</th>';
            QUESTIONS_DATA.forEach((_, qIdx) => {
                matrixHeaderRow.innerHTML += `<th class="p-2 text-center">C${qIdx + 1}</th>`;
            });
            matrixHeaderRow.innerHTML += '<th class="p-2 text-center rounded-r-xl">Tổng Đúng</th>';

            const matrixTableBody = document.getElementById('hostMatrixTableBody');
            matrixTableBody.innerHTML = '';

            sorted.forEach((p) => {
                const tr = document.createElement('tr');
                let rowHtml = `<td class="p-2 text-left font-bold text-white flex items-center gap-1">${p.elementConfig.emoji} ${p.name}</td>`;
                
                QUESTIONS_DATA.forEach((_, qIdx) => {
                    const ans = p.answerHistory[qIdx];
                    if (!ans || ans.choice === null) {
                        rowHtml += `<td class="p-1.5 text-center text-slate-500 font-bold">-</td>`;
                    } else if (ans.isCorrect) {
                        rowHtml += `<td class="p-1.5 text-center"><span class="inline-flex items-center justify-center w-5 h-5 rounded-full bg-emerald-500/20 text-emerald-400 border border-emerald-500/40 text-xs">✓</span></td>`;
                    } else {
                        rowHtml += `<td class="p-1.5 text-center"><span class="inline-flex items-center justify-center w-5 h-5 rounded-full bg-rose-500/20 text-rose-400 border border-rose-500/40 text-xs">✗</span></td>`;
                    }
                });

                rowHtml += `<td class="p-2 text-center font-ui text-yellow-300">${p.correctCount}/${QUESTIONS_DATA.length}</td>`;
                tr.innerHTML = rowHtml;
                matrixTableBody.appendChild(tr);
            });

            hostPublish({ type: 'FINAL_PODIUM', isBossDefeated: isBossDefeated });
        }

        function exportBossRaidExcel() {
            const players = Object.values(hostState.players);
            if (players.length === 0) {
                showToast("Chưa có dữ liệu hiệp sĩ để xuất bảng điểm!", false);
                return;
            }

            const distinctClasses = [...new Set(players.map(p => p.className.trim()))].filter(c => c);
            const classNameLabel = distinctClasses.length > 0 ? distinctClasses.join('_') : "12A";

            const excelData = players.map((p, index) => {
                const avgSpeed = p.questionsAnswered > 0 ? (p.totalResponseTime / p.questionsAnswered).toFixed(2) : "0.00";
                const row = {
                    "STT": index + 1,
                    "Tên Tiểu Đội / Hiệp Sĩ": p.name,
                    "Lớp": p.className,
                    "Hệ Nguyên Tố": p.elementConfig.name,
                    "Tuyệt Kỹ Sở Hữu": p.elementConfig.skillName,
                    "Trạng Thái Sinh Tồn": p.isAlive ? "Sống Sót" : "Bị Hạ Gục (K.O)",
                    "Điểm Tấn Công (ATK)": p.atk,
                    "Máu Còn Lại (HP)": p.hp,
                    "Số Câu Đúng": `${p.correctCount}/${QUESTIONS_DATA.length}`,
                    "Tỉ Lệ Chính Xác (%)": Math.round((p.correctCount / QUESTIONS_DATA.length) * 100) + "%",
                    "Thời Gian Xuất Chiêu TB (giây)": avgSpeed
                };

                QUESTIONS_DATA.forEach((_, qIdx) => {
                    const ans = p.answerHistory[qIdx];
                    row[`Câu ${qIdx + 1}`] = !ans || ans.choice === null ? "Hết giờ" : (ans.isCorrect ? "Đúng" : "Sai");
                });

                return row;
            });

            const wb = XLSX.utils.book_new();
            const ws = XLSX.utils.json_to_sheet(excelData);
            XLSX.utils.book_append_sheet(wb, ws, `ThucThe_Lop_${classNameLabel}`);

            const fileName = `DaiChienThucTheNguyenTo_VatLi12_Lop_${classNameLabel}.xlsx`;
            XLSX.writeFile(wb, fileName);
            showToast(`✓ Đã xuất bảng điểm Excel thành công cho lớp ${classNameLabel}!`, true);
        }


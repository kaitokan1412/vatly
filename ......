        function handleHostIncomingData(data) {
            if (data.type === 'PLAYER_JOIN') {
                const pId = data.playerId;
                if (!pId) return;

                const chosenElementKey = data.element && ELEMENTS_CONFIG[data.element] ? data.element : 'thuy';
                const elementConfig = ELEMENTS_CONFIG[chosenElementKey];

                if (!hostState.players[pId]) {
                    hostState.players[pId] = {
                        id: pId,
                        name: data.name || "Hiệp sĩ",
                        className: data.className || "12A",
                        element: chosenElementKey,
                        elementConfig: elementConfig,
                        isBot: Boolean(data.isBot),
                        hp: 100,
                        atk: 0,
                        streak: 0,
                        roundAtkGained: 0,
                        roundHpGained: 0,
                        isCounterStrike: false,
                        isAlive: true,
                        correctCount: 0,
                        totalResponseTime: 0,
                        questionsAnswered: 0,
                        currentAnswer: null,
                        responseTime: 0,
                        answerHistory: {}
                    };
                    Sound.tick();
                    updateHostLobbyUI();
                } else {
                    hostState.players[pId].name = data.name || hostState.players[pId].name;
                    hostState.players[pId].className = data.className || hostState.players[pId].className;
                    hostState.players[pId].element = chosenElementKey;
                    hostState.players[pId].elementConfig = elementConfig;
                    updateHostLobbyUI();
                }

                const p = hostState.players[pId];
                hostPublish({
                    type: 'JOIN_ACK',
                    playerId: pId,
                    roomPin: roomPin,
                    element: p.element,
                    bossElement: hostState.bossElement,
                    hp: p.hp,
                    atk: p.atk,
                    isAlive: p.isAlive,
                    currentQIndex: hostState.currentQIndex
                });
            }
            else if (data.type === 'PLAYER_ANSWER') {
                const p = hostState.players[data.playerId];
                if (p && p.isAlive && p.currentAnswer === null && !hostState.isRoundEnded) {
                    const timeTaken = (Date.now() - hostState.startTime) / 1000;
                    p.currentAnswer = data.choice;
                    p.responseTime = timeTaken;
                    p.totalResponseTime += timeTaken;
                    p.questionsAnswered += 1;

                    const q = QUESTIONS_DATA[hostState.currentQIndex];
                    const isCorrect = (data.choice === q.correct);

                    p.answerHistory[hostState.currentQIndex] = {
                        choice: data.choice,
                        isCorrect: isCorrect,
                        time: timeTaken
                    };

                    if (isCorrect) {
                        p.correctCount++;
                        p.streak++;

                        // Kiểm tra cơ chế khắc hệ với Thực Thể
                        const isCountering = (p.elementConfig.counters === hostState.bossElement);
                        p.isCounterStrike = isCountering;

                        const timeRatio = Math.max(0, hostState.timer / 30);
                        let basePointGain = Math.round(70 + 50 * timeRatio);

                        // Thưởng chuỗi đúng
                        let streakBonus = 0;
                        if (p.streak >= 2) {
                            streakBonus = 10;
                            basePointGain += streakBonus;
                        }

                        // Nếu khắc hệ: cộng thêm 50% chỉ số ATK nhận được
                        let finalAtkGain = basePointGain;
                        if (isCountering) {
                            finalAtkGain = Math.round(basePointGain * 1.5);
                        }

                        p.atk += finalAtkGain;
                        p.hp += basePointGain; // HP hồi theo mức cơ bản
                        p.roundAtkGained = finalAtkGain;
                        p.roundHpGained = basePointGain;

                        hostPublish({
                            type: 'ROUND_FEEDBACK',
                            playerId: p.id,
                            isCorrect: true,
                            atk: p.atk,
                            hp: p.hp,
                            streak: p.streak,
                            pointGain: finalAtkGain,
                            isCounterStrike: isCountering,
                            streakBonus: streakBonus,
                            time: timeTaken,
                            skillName: p.elementConfig.skillName
                        });
                    } else {
                        p.streak = 0;
                        p.roundAtkGained = 0;
                        p.isCounterStrike = false;
                        p.hp = Math.max(0, p.hp - 20);
                        p.roundHpGained = -20;

                        if (p.hp <= 0) {
                            p.isAlive = false;
                            p.hp = 0;
                        }

                        hostPublish({
                            type: 'ROUND_FEEDBACK',
                            playerId: p.id,
                            isCorrect: false,
                            atk: p.atk,
                            hp: p.hp,
                            streak: 0,
                            pointGain: 0,
                            isCounterStrike: false,
                            streakBonus: 0,
                            time: timeTaken,
                            skillName: p.elementConfig.skillName
                        });
                    }

                    updateHostAnsweredCounter();
                    renderHostLiveSquadHud();

                    const alivePlayers = Object.values(hostState.players).filter(pl => pl.isAlive);
                    const answeredCount = alivePlayers.filter(pl => pl.currentAnswer !== null).length;
                    if (answeredCount >= alivePlayers.length && alivePlayers.length > 0) {
                        hostEndQuestionRound();
                    }
                }
            }
        }


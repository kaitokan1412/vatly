        /* =========================================================================
           KÊNH TRUYỀN DỮ LIỆU ĐỒNG BỘ THỜI GIAN THỰC (CANVAS NETBUS + MQTT)
           ========================================================================= */
        const MQTT_BROKER_URL = "wss://broker.emqx.io:8084/mqtt";
        let mqttClient = null;
        let roomPin = "";
        let isHost = false;

        const NetBus = {
            hostChannel: null,
            playerChannel: null,
            init(pin, onHostMessage, onPlayerMessage) {
                const hostChName = `elemboss_${pin}_host`;
                const playerChName = `elemboss_${pin}_player`;

                try {
                    if (typeof BroadcastChannel !== 'undefined') {
                        if (onHostMessage) {
                            this.hostChannel = new BroadcastChannel(hostChName);
                            this.hostChannel.onmessage = (e) => { if (e.data) onHostMessage(e.data); };
                        }
                        if (onPlayerMessage) {
                            this.playerChannel = new BroadcastChannel(playerChName);
                            this.playerChannel.onmessage = (e) => { if (e.data) onPlayerMessage(e.data); };
                        }
                    }
                } catch (e) {}

                window.addEventListener('storage', (e) => {
                    try {
                        if (onHostMessage && e.key === hostChName && e.newValue) {
                            onHostMessage(JSON.parse(e.newValue));
                        }
                        if (onPlayerMessage && e.key === playerChName && e.newValue) {
                            onPlayerMessage(JSON.parse(e.newValue));
                        }
                    } catch (err) {}
                });
            },
            publishToHost(pin, data) {
                const hostChName = `elemboss_${pin}_host`;
                if (this.hostChannel) {
                    try { this.hostChannel.postMessage(data); } catch(e) {}
                }
                try {
                    localStorage.setItem(hostChName, JSON.stringify(data));
                    setTimeout(() => { try { localStorage.removeItem(hostChName); } catch(e){} }, 40);
                } catch(e) {}
            },
            publishToPlayer(pin, data) {
                const playerChName = `elemboss_${pin}_player`;
                if (this.playerChannel) {
                    try { this.playerChannel.postMessage(data); } catch(e) {}
                }
                try {
                    localStorage.setItem(playerChName, JSON.stringify(data));
                    setTimeout(() => { try { localStorage.removeItem(playerChName); } catch(e){} }, 40);
                } catch(e) {}
            }
        };


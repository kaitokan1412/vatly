        function playerJoinRoom() {
            const pin = document.getElementById('playerPinInput').value.trim();
            const name = document.getElementById('playerNameInput').value.trim();
            const className = document.getElementById('playerClassInput').value.trim() || "12A";
            const statusMsg = document.getElementById('playerConnectStatusMsg');
            const submitBtn = document.getElementById('btnPlayerJoinSubmit');

            if (!pin || !name) {
                showToast("Vui lòng nhập đầy đủ Mã PIN và Tên Đội!", false);
                return;
            }

            roomPin = pin;
            playerState.myName = name;
            playerState.myClass = className;
            playerState.hp = 100;
            playerState.atk = 0;
            playerState.streak = 0;
            playerState.isAlive = true;

            document.getElementById('playerMyNameDisplay').innerText = `${name} (${className})`;
            document.getElementById('playerGameTeamLabel').innerText = name;

            statusMsg.classList.remove('hidden');
            statusMsg.innerText = "Đang kết nối vào đấu trường...";
            submitBtn.disabled = true;

            if (playerState.joinRetryInterval) clearInterval(playerState.joinRetryInterval);
            playerState.joinAttempts = 0;

            // Khởi tạo NetBus lắng nghe dữ liệu từ Giáo viên
            NetBus.init(roomPin, (data) => {
                handlePlayerIncomingData(data);
            }, null);

            const sendJoinPacket = () => {
                playerPublish({
                    type: 'PLAYER_JOIN',
                    playerId: playerState.playerId,
                    name: playerState.myName,
                    className: playerState.myClass,
                    element: playerState.myElement
                });
            };

            sendJoinPacket();

            // Kết nối MQTT dự phòng
            try {
                const clientId = "player_" + roomPin + "_" + playerState.playerId + "_" + Math.random().toString(36).substring(2, 6);
                if (mqttClient) { try { mqttClient.end(true); } catch(e) {} }
                mqttClient = mqtt.connect(MQTT_BROKER_URL, { clientId: clientId, clean: true, reconnectPeriod: 4000 });

                mqttClient.on('connect', () => {
                    const hostTopic = `elemboss/${roomPin}/host`;
                    mqttClient.subscribe(hostTopic, { qos: 1 }, () => {
                        sendJoinPacket();
                    });
                });

                mqttClient.on('message', (topic, message) => {
                    try {
                        const data = JSON.parse(message.toString());
                        handlePlayerIncomingData(data);
                    } catch(e) {}
                });
            } catch(e) {}

            playerState.joinRetryInterval = setInterval(() => {
                playerState.joinAttempts++;
                if (playerState.joinAttempts > 8) {
                    clearInterval(playerState.joinRetryInterval);
                    statusMsg.innerText = "❌ Không tìm thấy phòng hoặc mã PIN chưa đúng!";
                    submitBtn.disabled = false;
                    showToast("Không tìm thấy mã phòng này, hãy kiểm tra lại!", false);
                    return;
                }
                sendJoinPacket();
            }, 1000);
        }

        function playerPublish(data) {
            NetBus.publishToPlayer(roomPin, data);
            if (mqttClient && mqttClient.connected) {
                try {
                    const playerTopic = `elemboss/${roomPin}/player`;
                    mqttClient.publish(playerTopic, JSON.stringify(data), { qos: 1 });
                } catch(e) {}
            }
        }

        function updatePlayerBarsUI() {
            const hpBar = document.getElementById('playerHpBar');
            const hpText = document.getElementById('playerHpText');
            const atkBar = document.getElementById('playerAtkBar');
            const atkText = document.getElementById('playerAtkText');

            if (hpBar && hpText) {
                hpText.innerText = `${playerState.hp} HP`;
                hpBar.style.width = `${Math.min(100, Math.max(0, playerState.hp))}%`;

                if (playerState.hp > 50) {
                    hpBar.className = "h-full bg-gradient-to-r from-emerald-500 via-teal-400 to-green-500 rounded-full transition-all duration-500";
                } else if (playerState.hp > 20) {
                    hpBar.className = "h-full bg-gradient-to-r from-amber-500 to-orange-500 rounded-full transition-all duration-500";
                } else {
                    hpBar.className = "h-full bg-gradient-to-r from-red-600 to-rose-600 rounded-full transition-all duration-500";
                }
            }

            if (atkBar && atkText) {
                atkText.innerText = `${playerState.atk} ATK`;
                const maxDisplayAtk = 1200;
                const atkPercent = Math.min(100, Math.round((playerState.atk / maxDisplayAtk) * 100));
                atkBar.style.width = `${atkPercent}%`;
            }

            const streakBadge = document.getElementById('playerStreakBadge');
            const streakCount = document.getElementById('playerStreakCount');
            if (playerState.streak >= 2) {
                streakBadge.classList.remove('hidden');
                streakCount.innerText = playerState.streak;
            } else {
                streakBadge.classList.add('hidden');
            }
        }

        function handlePlayerIncomingData(data) {
            if (data.type === 'JOIN_ACK' && data.playerId === playerState.playerId) {
                if (playerState.joinRetryInterval) clearInterval(playerState.joinRetryInterval);

                const myConfig = ELEMENTS_CONFIG[playerState.myElement];
                document.getElementById('playerMyAvatarIcon').innerText = myConfig.emoji;
                document.getElementById('playerMyAvatarClass').innerText = `Hệ ${myConfig.name}`;
                document.getElementById('playerMySkillTag').innerText = `Chiêu: ${myConfig.skillName}`;

                document.getElementById('playerGameAvatarBadge').innerText = myConfig.emoji;
                document.getElementById('playerGameClassTag').innerText = `Hệ ${myConfig.name} • ${myConfig.skillName}`;

                // Cập nhật mục tiêu Thực Thể
                const bossElem = data.bossElement || 'hoa';
                updatePlayerLobbyTargetBoss(bossElem);

                hideAllScreens();
                document.getElementById('playerLobbyScreen').classList.remove('hidden');
                Sound.tick();
            }
            else if (data.type === 'QUESTION_START') {
                hideAllScreens();
                
                if (!playerState.isAlive) {
                    document.getElementById('playerEliminatedScreen').classList.remove('hidden');
                } else {
                    document.getElementById('playerGamepadScreen').classList.remove('hidden');
                    document.getElementById('playerButtonGrid').classList.remove('hidden');
                    document.getElementById('playerSubmittedOverlay').classList.add('hidden');
                    updatePlayerBarsUI();

                    const qIndex = data.qIndex !== undefined ? data.qIndex : 0;
                    const q = QUESTIONS_DATA[qIndex];
                    if (q) {
                        document.getElementById('playerQCounter').innerText = `CÂU ${qIndex + 1}/${QUESTIONS_DATA.length}`;
                        document.getElementById('playerQCategory').innerText = q.category;
                        document.getElementById('playerQuestionTitle').innerText = q.title;

                        const playerGraphBox = document.getElementById('playerQuestionGraphBox');
                        if (playerGraphBox) {
                            if (q.graphSvg) {
                                playerGraphBox.innerHTML = q.graphSvg;
                                playerGraphBox.classList.remove('hidden');
                            } else {
                                playerGraphBox.innerHTML = '';
                                playerGraphBox.classList.add('hidden');
                            }
                        }

                        document.getElementById('playerOptText0').innerText = q.options[0];
                        document.getElementById('playerOptText1').innerText = q.options[1];
                        document.getElementById('playerOptText2').innerText = q.options[2];
                        document.getElementById('playerOptText3').innerText = q.options[3];
                    }

                    // Đếm ngược 30 giây trên điện thoại
                    clearInterval(playerState.playerTimerInterval);
                    playerState.playerTimer = 30;
                    document.getElementById('playerTimerText').innerText = `${playerState.playerTimer}s`;
                    playerState.playerTimerInterval = setInterval(() => {
                        playerState.playerTimer--;
                        if (playerState.playerTimer >= 0) {
                            document.getElementById('playerTimerText').innerText = `${playerState.playerTimer}s`;
                        } else {
                            clearInterval(playerState.playerTimerInterval);
                        }
                    }, 1000);
                }
                playerState.selectedChoice = null;
            }
            else if (data.type === 'ROUND_FEEDBACK' && data.playerId === playerState.playerId) {
                clearInterval(playerState.playerTimerInterval);
                hideAllScreens();
                document.getElementById('playerFeedbackScreen').classList.remove('hidden');

                playerState.atk = data.atk;
                playerState.hp = data.hp;
                playerState.streak = data.streak;

                const myConfig = ELEMENTS_CONFIG[playerState.myElement];
                document.getElementById('playerFeedbackIcon').innerText = myConfig.emoji;
                document.getElementById('playerCastSkillBanner').innerText = `TUYỆT KỸ: ${myConfig.skillName.toUpperCase()}!`;

                const counterTag = document.getElementById('playerFeedbackCounterTag');
                if (data.isCounterStrike) {
                    counterTag.classList.remove('hidden');
                } else {
                    counterTag.classList.add('hidden');
                }

                const bonusTag = document.getElementById('playerFeedbackBonusTag');
                if (data.streakBonus > 0) {
                    bonusTag.classList.remove('hidden');
                    bonusTag.innerText = `🔥 Thưởng Chuỗi x${data.streak}: +${data.streakBonus} Điểm`;
                } else {
                    bonusTag.classList.add('hidden');
                }

                if (data.isCorrect) {
                    Sound.correct();
                    playElementalCanvasParticles('playerSkillCastCanvas', myConfig.color);
                    document.getElementById('playerFeedbackTitle').innerText = "TUNG CHIÊU TRÚNG MỤC TIÊU!";
                    document.getElementById('playerFeedbackTitle').className = "text-xl sm:text-2xl font-rpg font-black text-emerald-400 mb-1";
                    document.getElementById('playerFeedbackPts').innerText = `+${data.pointGain} ATK & HP (Sức mạnh: ${data.atk} ATK)`;
                } else {
                    Sound.wrong();
                    document.getElementById('playerFeedbackIcon').innerText = "❌";
                    document.getElementById('playerFeedbackTitle').innerText = "XUẤT CHIÊU TRƯỢT (-20 HP)!";
                    document.getElementById('playerFeedbackTitle').className = "text-xl sm:text-2xl font-rpg font-black text-rose-400 mb-1";
                    document.getElementById('playerFeedbackPts').innerText = "+0 ATK | -20 HP";
                }

                document.getElementById('playerFeedbackSpeed').innerText = `Thời gian xuất chiêu: ${data.time.toFixed(2)}s`;
                updatePlayerBarsUI();
            }
            else if (data.type === 'BOSS_ATTACKED_PLAYER' && data.playerId === playerState.playerId) {
                playerState.hp = data.hp;
                updatePlayerBarsUI();

                hideAllScreens();
                const retaliateScreen = document.getElementById('playerBossRetaliateScreen');
                retaliateScreen.classList.remove('hidden');

                const bossConfig = ELEMENTS_CONFIG[data.bossElement] || ELEMENTS_CONFIG['hoa'];
                document.getElementById('playerRetaliateIcon').innerText = bossConfig.emoji;
                document.getElementById('playerRetaliateBossTitle').innerText = `${bossConfig.title} PHẢN KÍCH!`;

                const dmgNum = document.getElementById('playerRetaliateDamageNumber');
                dmgNum.innerText = `-${data.damageTaken} HP`;

                const counterDesc = document.getElementById('playerRetaliateCounterDesc');
                if (data.bossCountersPlayer) {
                    dmgNum.className = "text-3xl font-rpg font-black text-red-500 animate-pulse";
                    counterDesc.innerHTML = `⚠️ <strong class="text-red-400">THỰC THỂ KHẮC HỆ BẠN!</strong> Chịu thêm 50% sát thương (${data.damageTaken} HP)!`;
                } else {
                    dmgNum.className = "text-2xl font-rpg font-black text-rose-300";
                    counterDesc.innerText = `Thực Thể tung đại chiêu ${data.bossSkillName} quét trúng toàn đội!`;
                }

                Sound.bossRoar();
                const body = document.getElementById('appBody');
                body.classList.add('shake-damage', 'flash-red');
                setTimeout(() => {
                    body.classList.remove('shake-damage', 'flash-red');
                }, 800);
            }
            else if (data.type === 'PLAYER_ELIMINATED' && data.playerId === playerState.playerId) {
                clearInterval(playerState.playerTimerInterval);
                playerState.isAlive = false;
                playerState.hp = 0;
                hideAllScreens();
                document.getElementById('playerEliminatedScreen').classList.remove('hidden');
                Sound.defeat();
            }
            else if (data.type === 'LEADERBOARD_STATE') {
                clearInterval(playerState.playerTimerInterval);
                hideAllScreens();
                if (!playerState.isAlive) {
                    document.getElementById('playerEliminatedScreen').classList.remove('hidden');
                } else {
                    document.getElementById('playerLobbyScreen').classList.remove('hidden');
                    document.getElementById('playerLobbyStatusText').innerText = "HÃY THEO DÕI MÀN HÌNH MÁY CHIẾU...";
                    document.getElementById('playerLobbySubText').innerText = "Xem hoạt cảnh Thực Thể phản kích và bảng xếp hạng sức mạnh!";
                }
            }
            else if (data.type === 'FINAL_PODIUM') {
                clearInterval(playerState.playerTimerInterval);
                hideAllScreens();
                document.getElementById('playerLobbyScreen').classList.remove('hidden');
                document.getElementById('playerLobbyStatusText').innerText = data.isBossDefeated ? "🏆 THỰC THỂ ĐÃ BỊ TIÊU DIỆT!" : "💀 TRẬN CHIẾN KẾT THÚC!";
                document.getElementById('playerLobbySubText').innerText = "Hãy nhìn lên máy chiếu để xem vinh danh và tổng kết trận đánh!";
            }
        }

        function updatePlayerLobbyTargetBoss(bossElemKey) {
            const bossConfig = ELEMENTS_CONFIG[bossElemKey] || ELEMENTS_CONFIG['hoa'];
            document.getElementById('playerLobbyTargetElementBadge').innerText = `HỆ ${bossConfig.name.toUpperCase()}`;
            document.getElementById('playerLobbyTargetElementBadge').className = `text-[10px] font-bold px-2 py-0.5 rounded-full ${bossConfig.badgeBg}`;

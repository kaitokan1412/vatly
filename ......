                            <span class="font-rpg font-bold text-xs text-white truncate max-w-[95px]">${p.name}</span>
                            <span class="text-[9px] text-slate-400 font-bold">(${p.className})</span>
                        </div>
                        <div>${statusBadge}</div>
                    </div>

                    <!-- Live HP Bar -->
                    <div class="flex flex-col gap-0.5">
                        <div class="flex justify-between text-[9px] font-ui font-black text-purple-300">
                            <span>HP:</span>
                            <span class="${p.hp > 50 ? 'text-emerald-400' : (p.hp > 0 ? 'text-orange-400' : 'text-red-500')}">${p.hp} HP</span>
                        </div>
                        <div class="w-full h-1.5 bg-black/90 rounded-full border border-purple-600/40 overflow-hidden">
                            <div class="h-full ${p.hp > 50 ? 'bg-gradient-to-r from-emerald-500 to-green-400' : (p.hp > 20 ? 'bg-gradient-to-r from-amber-500 to-orange-500' : 'bg-gradient-to-r from-red-600 to-rose-600')} rounded-full transition-all duration-500" style="width: ${hpPercent}%;"></div>
                        </div>
                    </div>

                    <!-- Live ATK Bar -->
                    <div class="flex flex-col gap-0.5">
                        <div class="flex justify-between text-[9px] font-ui font-black text-amber-300">
                            <span>ATK:</span>
                            <span class="text-yellow-300">${p.atk} ATK</span>
                        </div>
                        <div class="w-full h-1.5 bg-black/90 rounded-full border border-amber-500/40 overflow-hidden">
                            <div class="h-full bg-gradient-to-r from-amber-500 via-orange-500 to-yellow-300 rounded-full transition-all duration-500" style="width: ${atkPercent}%;"></div>
                        </div>
                    </div>
                `;
                grid.appendChild(card);
            });
        }

        function hostEndQuestionRound() {
            if (hostState.isRoundEnded) return;
            hostState.isRoundEnded = true;
            clearInterval(hostState.timerInterval);

            Object.values(hostState.players).forEach(p => {
                if (p.isAlive && p.currentAnswer === null && !p.answerHistory[hostState.currentQIndex]) {
                    p.answerHistory[hostState.currentQIndex] = {
                        choice: null,
                        isCorrect: false,
                        time: 30
                    };
                    p.streak = 0;
                    p.hp = Math.max(0, p.hp - 20);
                    if (p.hp <= 0) p.isAlive = false;
                }
            });

            const q = QUESTIONS_DATA[hostState.currentQIndex];
            for (let idx = 0; idx < 4; idx++) {
                const card = document.getElementById(`hostOptCard${idx}`);
                const badge = document.getElementById(`optBadge${idx}`);

                if (idx === q.correct) {
                    card.classList.add('scale-[1.02]', 'ring-4', 'ring-emerald-400', 'shadow-[0_0_30px_rgba(52,211,153,0.7)]');
                    badge.classList.remove('hidden');
                } else {
                    card.classList.add('opacity-30');
                }
            }

            Sound.correct();
            const expBox = document.getElementById('hostExplanationBox');
            if (expBox) {
                if (q.explanation) {
                    expBox.innerHTML = `<span class="text-amber-400 font-black">💡 GIẢI THÍCH CHI TIẾT (GIÁO VIÊN):</span><br>${q.explanation}`;
                    expBox.classList.remove('hidden');
                } else {
                    expBox.classList.add('hidden');
                }
            }
            document.getElementById('hostQuestionActionArea').classList.remove('hidden');
        }

        function updateHostAnsweredCounter() {
            const answered = Object.values(hostState.players).filter(pl => pl.isAlive && pl.currentAnswer !== null).length;
            document.getElementById('hostAnsweredCount').innerText = answered;
        }

        /* =========================================================================
           HOẠT CẢNH THỰC THỂ TUNG CHIÊU, BIẾN HÌNH NGUYÊN TỐ & PHẢN KÍCH
           ========================================================================= */
        function hostResolveBossRaidRound() {
            hideAllScreens();
            document.getElementById('hostRaidScreen').classList.remove('hidden');
            document.getElementById('bossEliminationAlert').classList.add('hidden');

            const arena = document.getElementById('bossBattleArena');
            const body = document.getElementById('appBody');
            const curBossConfig = ELEMENTS_CONFIG[hostState.bossElement];

            // Cập nhật giao diện Thực Thể chiến đấu
            const avatarBox = document.getElementById('bossBattleAvatarBox');
            avatarBox.innerHTML = getElementalTitanSvg(hostState.bossElement, 180, 230);

            const elementTag = document.getElementById('bossBattleElementTag');
            elementTag.className = `px-3 py-0.5 rounded-full text-xs font-rpg font-black uppercase tracking-wider border shadow-md ${curBossConfig.badgeBg}`;
            elementTag.innerText = `HỆ ${curBossConfig.name.toUpperCase()}`;

            document.getElementById('bossBattleName').innerText = curBossConfig.title;
            const skillBanner = document.getElementById('bossSkillBanner');
            skillBanner.className = `mt-2.5 px-6 py-1.5 rounded-full text-white font-rpg font-black text-xs sm:text-sm uppercase tracking-widest shadow-xl border border-white/40 hidden animate-bounce ${curBossConfig.badgeBg}`;
            skillBanner.innerText = `💥 ĐẠI CHIÊU: ${curBossConfig.skillName.toUpperCase()}`;

            const circle = document.getElementById('hostArenaBossCircle');
            circle.style.color = curBossConfig.color;

            // 1. TỔNG LƯỢNG ATK CỦA HỌC SINH TẤN CÔNG VÀO THỰC THỂ
            let totalDamageToBoss = 0;
            let hitCount = 0;
            let counterHitCount = 0;

            Object.values(hostState.players).forEach(p => {
                if (p.isAlive && p.roundAtkGained > 0) {
                    totalDamageToBoss += p.atk;
                    hitCount++;
                    if (p.isCounterStrike) counterHitCount++;
                }
            });

            hostState.bossCurrentHp = Math.max(0, hostState.bossCurrentHp - totalDamageToBoss);
            Sound.slash();
            playElementalCanvasParticles('hostBossEffectCanvas', curBossConfig.color);

            const hpPercent = Math.max(0, Math.round((hostState.bossCurrentHp / hostState.bossMaxHp) * 100));
            document.getElementById('bossHpNumber').innerText = `${hostState.bossCurrentHp.toLocaleString()} / ${hostState.bossMaxHp.toLocaleString()} HP (${hpPercent}%)`;
            document.getElementById('bossBattleHpBar').style.width = `${hpPercent}%`;

            const statusTxt = document.getElementById('bossBattleStatusText');
            if (statusTxt) {
                statusTxt.innerHTML = totalDamageToBoss > 0
                    ? `⚡ <strong class="text-amber-300">${hitCount} Hiệp sĩ</strong> đồng loạt tung chiêu (có <strong class="text-emerald-400">${counterHitCount} đòn khắc hệ +50% ATK</strong>) chém <strong class="text-yellow-300 font-black">-${totalDamageToBoss.toLocaleString()} HP</strong> vào Thực Thể!`
                    : `❌ Không có đòn đánh trúng ở hiệp này! Thực Thể nguyên vẹn sinh lực.`;
            }

            // 2. THỰC THỂ TUNG CHIÊU PHẢN KÍCH (ÁP DỤNG KHẮC HỆ LÊN HỌC SINH)
            setTimeout(() => {
                Sound.bossRoar();
                skillBanner.classList.remove('hidden');
                arena.classList.add('shake-damage');
                body.classList.add('flash-red');

                setTimeout(() => {
                    arena.classList.remove('shake-damage');
                    body.classList.remove('flash-red');
                }, 800);

                hostState.eliminatedThisRound = [];
                Object.values(hostState.players).forEach(p => {
                    if (p.isAlive) {
                        // Nếu hệ của Boss khắc hệ của học sinh: trừ 75 HP thay vì 50 HP!
                        const bossCountersPlayer = (curBossConfig.counters === p.element);
                        const damageTaken = bossCountersPlayer ? 75 : 50;

                        p.hp = Math.max(0, p.hp - damageTaken);

                        if (p.hp <= 0) {
                            p.isAlive = false;
                            p.hp = 0;
                            hostState.eliminatedThisRound.push(p.name);
                            hostPublish({ type: 'PLAYER_ELIMINATED', playerId: p.id });
                        } else {
                            hostPublish({ 
                                type: 'BOSS_ATTACKED_PLAYER', 
                                playerId: p.id, 
                                hp: p.hp,
                                damageTaken: damageTaken,
                                bossCountersPlayer: bossCountersPlayer,
                                bossElement: hostState.bossElement,
                                bossSkillName: curBossConfig.skillName
                            });
                        }
                    }
                });

                if (hostState.eliminatedThisRound.length > 0) {
                    document.getElementById('bossEliminationAlert').classList.remove('hidden');
                    document.getElementById('bossEliminationAlertText').innerText = `⚡ THỰC THỂ ĐÃ HẠ GỤC: ${hostState.eliminatedThisRound.join(', ')} (Cạn HP)!`;
                }

                // 3. THỰC THỂ BIẾN HÌNH SANG NGUYÊN TỐ MỚI CHO HIỆP TIẾP THEO
                setTimeout(() => {
                    const otherElements = ELEMENT_KEYS.filter(k => k !== hostState.bossElement);
                    const newElementKey = otherElements[Math.floor(Math.random() * otherElements.length)];
                    hostState.bossElement = newElementKey;
                    const nextBossConfig = ELEMENTS_CONFIG[newElementKey];

                    Sound.morph();
                    document.getElementById('bossMorphNoticeBadge').classList.remove('hidden');

                    setTimeout(() => {
                        document.getElementById('bossMorphNoticeBadge').classList.add('hidden');
                        avatarBox.innerHTML = getElementalTitanSvg(newElementKey, 180, 230);
                        elementTag.className = `px-3 py-0.5 rounded-full text-xs font-rpg font-black uppercase tracking-wider border shadow-md ${nextBossConfig.badgeBg}`;
                        elementTag.innerText = `HỆ ${nextBossConfig.name.toUpperCase()}`;
                        document.getElementById('bossBattleName').innerText = nextBossConfig.title;
                        circle.style.color = nextBossConfig.color;
                        statusTxt.innerHTML = `🌀 Thực Thể đã chuyển hóa thành <strong class="text-amber-300 font-black">${nextBossConfig.title}</strong>! Điểm yếu hiệp tới: <strong class="text-emerald-400 font-bold">Hệ ${ELEMENTS_CONFIG[nextBossConfig.counteredBy].name}</strong>!`;
                    }, 1200);
                }, 1600);

                renderHostSquadList();
                renderHostDpsLeaderboard();
            }, 1200);

            renderHostSquadList();
            renderHostDpsLeaderboard();
            hostPublish({ type: 'LEADERBOARD_STATE' });
        }


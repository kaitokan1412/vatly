            const elemTag = document.getElementById('hostTopBossElementTag');
            elemTag.className = `px-2.5 py-0.5 rounded-full text-[10px] ${bossConfig.badgeBg}`;
            elemTag.innerText = `HỆ ${bossConfig.name.toUpperCase()}`;

            // Hiển thị đồ thị nếu có
            const hostGraphBox = document.getElementById('hostQuestionGraphBox');
            if (hostGraphBox) {
                if (q.graphSvg) {
                    hostGraphBox.innerHTML = q.graphSvg;
                    hostGraphBox.classList.remove('hidden');
                } else {
                    hostGraphBox.innerHTML = '';
                    hostGraphBox.classList.add('hidden');
                }
            }

            for (let idx = 0; idx < 4; idx++) {
                document.getElementById(`optText${idx}`).innerText = q.options[idx];
                const card = document.getElementById(`hostOptCard${idx}`);
                const badge = document.getElementById(`optBadge${idx}`);
                badge.classList.add('hidden');
                card.classList.remove('opacity-30', 'scale-[1.02]', 'ring-4', 'ring-emerald-400', 'shadow-[0_0_30px_rgba(52,211,153,0.7)]');
            }

            Object.values(hostState.players).forEach(p => {
                p.currentAnswer = null;
                p.roundAtkGained = 0;
                p.roundHpGained = 0;
                p.isCounterStrike = false;
            });

            const aliveCount = Object.values(hostState.players).filter(pl => pl.isAlive).length;
            document.getElementById('hostAlivePlayers').innerText = aliveCount;
            document.getElementById('hostAnsweredCount').innerText = "0";

            const hpPercent = Math.max(0, Math.round((hostState.bossCurrentHp / hostState.bossMaxHp) * 100));
            document.getElementById('hostTopBossHpText').innerText = `HP: ${hostState.bossCurrentHp.toLocaleString()} / ${hostState.bossMaxHp.toLocaleString()} (${hpPercent}%)`;
            document.getElementById('hostTopBossHpBar').style.width = `${hpPercent}%`;

            renderHostLiveSquadHud();
            hostPublish({ 
                type: 'QUESTION_START', 
                qIndex: hostState.currentQIndex,
                bossElement: hostState.bossElement
            });

            // Tự động cho Bot xuất chiêu
            hostState.botTimers.forEach(t => clearTimeout(t));
            hostState.botTimers = [];

            const aliveBots = Object.values(hostState.players).filter(p => p.isAlive && p.isBot);
            aliveBots.forEach(bot => {
                const randomDelay = 2500 + Math.random() * 12000;
                const willBeCorrect = Math.random() < 0.8;
                const botChoice = willBeCorrect ? q.correct : (q.correct + 1 + Math.floor(Math.random() * 3)) % 4;

                const timer = setTimeout(() => {
                    if (!hostState.isRoundEnded && bot.isAlive && bot.currentAnswer === null) {
                        handleHostIncomingData({
                            type: 'PLAYER_ANSWER',
                            playerId: bot.id,
                            choice: botChoice
                        });
                    }
                }, randomDelay);
                hostState.botTimers.push(timer);
            });

            hostState.timer = 30;
            hostState.startTime = Date.now();
            document.getElementById('hostTimerText').innerText = hostState.timer;

            clearInterval(hostState.timerInterval);
            hostState.timerInterval = setInterval(() => {
                hostState.timer--;
                document.getElementById('hostTimerText').innerText = hostState.timer;
                if (hostState.timer <= 5 && hostState.timer > 0) Sound.tick();

                if (hostState.timer <= 0) {
                    hostEndQuestionRound();
                }
            }, 1000);
        }

        function renderHostLiveSquadHud() {
            const grid = document.getElementById('hostLiveSquadGrid');
            if (!grid) return;
            grid.innerHTML = '';

            const players = Object.values(hostState.players);
            if (players.length === 0) return;

            players.forEach(p => {
                const card = document.createElement('div');
                const isAnswered = p.currentAnswer !== null;
                const hpPercent = Math.min(100, Math.max(0, p.hp));
                const maxAtkDisplay = 1200;
                const atkPercent = Math.min(100, Math.round((p.atk / maxAtkDisplay) * 100));

                let statusBadge = '';
                if (!p.isAlive) {
                    statusBadge = '<span class="text-[9px] px-1.5 py-0.2 rounded bg-red-600 text-white font-black">💀 K.O</span>';
                } else if (isAnswered) {
                    if (p.roundAtkGained > 0) {
                        statusBadge = p.isCounterStrike 
                            ? `<span class="text-[9px] px-1.5 py-0.2 rounded bg-amber-500/30 text-amber-300 font-black border border-amber-400 animate-pulse">⚡ Khắc +${p.roundAtkGained}</span>`
                            : `<span class="text-[9px] px-1.5 py-0.2 rounded bg-emerald-500/30 text-emerald-300 font-bold border border-emerald-400">✓ +${p.roundAtkGained}</span>`;
                    } else {
                        statusBadge = `<span class="text-[9px] px-1.5 py-0.2 rounded bg-rose-500/30 text-rose-300 font-bold border border-rose-400">✗ -20 HP</span>`;
                    }
                } else {
                    statusBadge = '<span class="text-[9px] px-1.5 py-0.2 rounded bg-purple-500/20 text-purple-300 font-bold border border-purple-500/40 animate-pulse">⏳ Tụ khí...</span>';
                }

                card.className = `p-2 rounded-xl border flex flex-col gap-1 transition-all duration-300 ${
                    p.isAlive ? (isAnswered ? 'bg-black/80 border-purple-500/60 shadow-lg scale-[1.01]' : 'bg-black/60 border-purple-900/50') : 'bg-red-950/20 border-slate-800 opacity-40 grayscale'
